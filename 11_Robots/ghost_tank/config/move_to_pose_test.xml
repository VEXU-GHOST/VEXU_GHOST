<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="move_to_pose_test">
  <BehaviorTree ID="move_to_pose_test">
    <Sequence>
      <MoveToPoseBoomerang
        posX_tiles="2.0"
        posY_tiles="2.0"
        theta_deg="90.0"
        search_radius_m="0.2"
        threshold_m="0.10"
        angle_threshold_deg="1.0"
        threshold_vel_mps="0.05"
        angle_threshold_vel_dps="5.0"
        lead="0.5"
        max_speed_linear_pct="0.5"
        max_speed_angular_pct="1.0"
        timeout_ms="-5000"
        use_theta="true"
        backwards="false"/>
      <ShutoffNode/>
      <Delay delay_msec="2000">
        <ShutoffNode/>
      </Delay>

      <MoveToPoseBoomerang
        posX_tiles="2.0"
        posY_tiles="2.0"
        theta_deg="180.0"
        search_radius_m="0.3"
        threshold_m="0.10"
        angle_threshold_deg="1.0"
        threshold_vel_mps="0.05"
        angle_threshold_vel_dps="5.0"
        lead="0.5"
        max_speed_linear_pct="0.5"
        max_speed_angular_pct="1.0"
        timeout_ms="-5000"
        use_theta="true"
        backwards="false"/>
      <ShutoffNode/>
      <Delay delay_msec="2000">
        <ShutoffNode/>
      </Delay>

      <MoveToPoseBoomerang
        posX_tiles="3.0"
        posY_tiles="1.0"
        theta_deg="0.0"
        search_radius_m="0.3"
        threshold_m="0.10"
        angle_threshold_deg="1.0"
        threshold_vel_mps="0.05"
        angle_threshold_vel_dps="5.0"
        lead="0.5"
        max_speed_linear_pct="0.5"
        max_speed_angular_pct="1.0"
        timeout_ms="-5000"
        use_theta="true"
        backwards="true"/>
      <ShutoffNode/>
      <Delay delay_msec="2000">
        <ShutoffNode/>
      </Delay>


      <MoveToPoseBoomerang
        posX_tiles="1.0"
        posY_tiles="2.0"
        theta_deg="135.0"
        search_radius_m="0.3"
        threshold_m="0.10"
        angle_threshold_deg="1.0"
        threshold_vel_mps="0.05"
        angle_threshold_vel_dps="5.0"
        lead="0.5"
        max_speed_linear_pct="0.5"
        max_speed_angular_pct="1.0"
        timeout_ms="-5000"
        use_theta="true"
        backwards="false"/>
      <ShutoffNode/>
      <Delay delay_msec="2000">
        <ShutoffNode/>
      </Delay>

      <Logging message="Auton Complete"/>
      <Delay delay_msec="50000">
        <ShutoffNode/>
      </Delay>
    </Sequence>
  </BehaviorTree>

<!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="BiteCmd"
            editable="true">
      <input_port name="bite_closed"/>
    </Action>
    <Action ID="ClampCmd"
            editable="true">
      <input_port name="clamp_closed"/>
    </Action>
    <Action ID="ConveyorCmd"
            editable="true">
      <input_port name="fwd"/>
    </Action>
    <Action ID="GoalRushCmd"
            editable="true">
      <input_port name="arm_down"/>
    </Action>
    <Action ID="SetMirrored"
            editable="true">
      <input_port name="mirrored"/>
    </Action>
    <Action ID="IntakeCmd"
            editable="true">
      <input_port name="lower"/>
      <input_port name="red"/>
    </Action>
    <Action ID="Logging"
            editable="true">
      <input_port name="message"/>
    </Action>
    <Action ID="MoveToPoseBoomerang"
            editable="true">
      <input_port name="posX_tiles"/>
      <input_port name="posY_tiles"/>
      <input_port name="theta_deg"/>
      <input_port name="search_radius_m"/>
      <input_port name="threshold_m"/>
      <input_port name="angle_threshold_deg"/>
      <input_port name="threshold_vel_mps"/>
      <input_port name="angle_threshold_vel_dps"/>
      <input_port name="lead"/>
      <input_port name="max_speed_linear_pct"/>
      <input_port name="max_speed_angular_pct"/>
      <input_port name="timeout_ms"/>
      <input_port name="use_theta"/>
      <input_port name="backwards"/>
    </Action>
    <Action ID="MoveToPosePurepursuit"
            editable="true">
      <input_port name="fileName"/>
      <input_port name="angle_threshold"
                  default="5.0">m</input_port>
      <input_port name="threshold"
                  default="0.025">m</input_port>
      <input_port name="timeout"
                  default="5000">ms</input_port>
      <input_port name="use_theta"
                  default="false"/>
    </Action>
    <Action ID="ShutoffNode"
            editable="true"/>
  </TreeNodesModel>

</root>