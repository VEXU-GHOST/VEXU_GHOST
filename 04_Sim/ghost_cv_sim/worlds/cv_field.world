<?xml version="1.0"?>
<!-- CV test field: 12 ft x 12 ft VEX field (floor top at z=0, centre at 0,0) + free-flying camera.
     Game objects are NOT in this file: scene_manager spawns them at run time.
     The camera is a kinematic, gravity-free model teleported by camera_scanner via
     /cv_sim/set_entity_state. Edit the <camera> block to match your real camera's resolution/FOV. -->
<sdf version="1.6">
  <world name="cv_field">
    <physics type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.55 0.6 0.65 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.75 0.75 0.75 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>
    <light name="fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.25 0.25 0.25 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0.5 -0.3 -0.6</direction>
    </light>

    <!-- Service for teleporting the camera: /cv_sim/set_entity_state -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/cv_sim</namespace></ros>
      <update_rate>1.0</update_rate>
    </plugin>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
        <visual name="v">
          <pose>0 0 -0.021 0 0 0</pose>
          <geometry><box><size>20 20 0.002</size></box></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="field">
      <static>true</static>
      <link name="link">
        <visual name="floor">
          <pose>0.000 0.000 -0.0100 0 0 0</pose>
          <geometry><box><size>3.660 3.660 0.0200</size></box></geometry>
          <material><ambient>0.42 0.43 0.45 1</ambient><diffuse>0.42 0.43 0.45 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
        <visual name="seam_x1">
          <pose>-1.220 0.000 0.0005 0 0 0</pose>
          <geometry><box><size>0.006 3.660 0.0010</size></box></geometry>
          <material><ambient>0.18 0.18 0.2 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
        <visual name="seam_y1">
          <pose>0.000 -1.220 0.0005 0 0 0</pose>
          <geometry><box><size>3.660 0.006 0.0010</size></box></geometry>
          <material><ambient>0.18 0.18 0.2 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
        <visual name="seam_x2">
          <pose>-0.610 0.000 0.0005 0 0 0</pose>
          <geometry><box><size>0.006 3.660 0.0010</size></box></geometry>
          <material><ambient>0.18 0.18 0.2 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
        <visual name="seam_y2">
          <pose>0.000 -0.610 0.0005 0 0 0</pose>
          <geometry><box><size>3.660 0.006 0.0010</size></box></geometry>
          <material><ambient>0.18 0.18 0.2 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
        <visual name="seam_x3">
          <pose>0.000 0.000 0.0005 0 0 0</pose>
          <geometry><box><size>0.006 3.660 0.0010</size></box></geometry>
          <material><ambient>0.18 0.18 0.2 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
        <visual name="seam_y3">
          <pose>0.000 0.000 0.0005 0 0 0</pose>
          <geometry><box><size>3.660 0.006 0.0010</size></box></geometry>
          <material><ambient>0.18 0.18 0.2 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
        <visual name="seam_x4">
          <pose>0.610 0.000 0.0005 0 0 0</pose>
          <geometry><box><size>0.006 3.660 0.0010</size></box></geometry>
          <material><ambient>0.18 0.18 0.2 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
        <visual name="seam_y4">
          <pose>0.000 0.610 0.0005 0 0 0</pose>
          <geometry><box><size>3.660 0.006 0.0010</size></box></geometry>
          <material><ambient>0.18 0.18 0.2 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
        <visual name="seam_x5">
          <pose>1.220 0.000 0.0005 0 0 0</pose>
          <geometry><box><size>0.006 3.660 0.0010</size></box></geometry>
          <material><ambient>0.18 0.18 0.2 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
        <visual name="seam_y5">
          <pose>0.000 1.220 0.0005 0 0 0</pose>
          <geometry><box><size>3.660 0.006 0.0010</size></box></geometry>
          <material><ambient>0.18 0.18 0.2 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
        <visual name="wall_n">
          <pose>0.000 1.855 0.1000 0 0 0</pose>
          <geometry><box><size>3.760 0.050 0.2000</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
        <visual name="wall_s">
          <pose>0.000 -1.855 0.1000 0 0 0</pose>
          <geometry><box><size>3.760 0.050 0.2000</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
        <visual name="wall_e">
          <pose>1.855 0.000 0.1000 0 0 0</pose>
          <geometry><box><size>0.050 3.660 0.2000</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
        <visual name="wall_w">
          <pose>-1.855 0.000 0.1000 0 0 0</pose>
          <geometry><box><size>0.050 3.660 0.2000</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="cv_camera">
      <static>false</static>
      <pose>0 0 0.35 0 0.35 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <!-- body sits behind the lens so it never appears in its own image -->
        <visual name="body">
          <pose>-0.03 0 0 0 0 0</pose>
          <geometry><box><size>0.04 0.08 0.04</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <sensor name="camera" type="camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>false</visualize>
          <camera>
            <!-- horizontal FOV in radians (1.309 = 75 deg): set to your real camera's -->
            <horizontal_fov>1.309</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>10</far></clip>
            <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
          </camera>
          <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
            <ros><namespace>/cv_sim</namespace></ros>
            <camera_name>camera</camera_name>
            <frame_name>cv_camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
