  <BehaviorTree ID="main">
    <Sequence>
      <ReactiveSequence>
        <Logging message="test"/>
        <Fallback>
          <Timeout msec="5000">
            <GoalRushCmd arm_down="true"/>
          </Timeout>
          <GoalRushCmd arm_down="false"/>
        </Fallback>
        <ClampCmd clamp_closed="true"/>
        <MoveToPoseBoomerang posX_tiles=""
                             posY_tiles="1.0"
                             theta_deg="0.0"
                             search_radius_m="0.3"
                             threshold_m="0.10"
                             angle_threshold_deg="5.0"
                             threshold_vel_mps="0.05"
                             angle_threshold_vel_dps="5.0"
                             lead="0.5"
                             max_speed_linear_pct="1.0"
                             max_speed_angular_pct="1.0"
                             timeout_ms="5000"
                             use_theta="true"
                             backwards="true"/>
      </ReactiveSequence>
      <Logging message="testover"/>
      <ShutoffNode/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="side">
    <Sequence>
      <Logging message="test"/>
      <MoveToPosePurepursuit fileName="~/VEXU_GHOST/11_Robots/ghost_tank/config/path.txt"
                             angle_threshold="165.0"
                             threshold="0.2"
                             timeout="1000"
                             use_theta="false"/>
      <Logging message="testover"/>
      <ShutoffNode/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="test_intake">
    <KeepRunningUntilFailure>
      <ReactiveSequence>
        <IntakeCmd lower="true" red="false"/>
        <ClampCmd clamp_closed="true"/>
        <BiteCmd bite_closed="true"/>
      </ReactiveSequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <BehaviorTree ID="win_point">
    <Sequence>
      <Logging message="win_point"/>
      <ReactiveSequence>
        <ClampCmd clamp_closed="false"/>
        <MoveToPoseBoomerang posX_tiles="2.8"
                             posY_tiles="0.8"
                             theta_deg="45.0"
                             search_radius_m="0.3"
                             threshold_m="0.10"
                             angle_threshold_deg="5.0"
                             threshold_vel_mps="0.05"
                             angle_threshold_vel_dps="5.0"
                             lead="0.5"
                             max_speed_linear_pct="1.0"
                             max_speed_angular_pct="1.0"
                             timeout_ms="-3000"
                             use_theta="true"
                             backwards="true"/>
      </ReactiveSequence>
      <Logging message="grabbing goal"/>
      <Logging message="going to rings at 1,1"/>
      <ReactiveSequence>
        <ClampCmd clamp_closed="true"/>
        <BiteCmd bite_closed="true"/>
        <IntakeCmd lower="true"
                   red="false"/>
        <MoveToPoseBoomerang posX_tiles="1.0"
                             posY_tiles="1.0"
                             theta_deg="135.0"
                             search_radius_m="0.3"
                             threshold_m="0.10"
                             angle_threshold_deg="5.0"
                             threshold_vel_mps="0.05"
                             angle_threshold_vel_dps="5.0"
                             lead="0.5"
