<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="tune_movement">
    <Sequence>
      <!-- ===== Sorter (digital port 0) ===== -->
      <SorterCmd sorter_active="true"/>
      <WaitCmd seconds="2.0"
        shutoff_motors="true"/>
      <SorterCmd sorter_active="false"/>
      <WaitCmd seconds="2.0"
        shutoff_motors="true"/>

      <!-- ===== Switcher (digital port 2) ===== -->
      <SwitcherCmd switcher_active="true"/>
      <WaitCmd seconds="2.0"
        shutoff_motors="true"/>
      <SwitcherCmd switcher_active="false"/>
      <WaitCmd seconds="2.0"
        shutoff_motors="true"/>

      <!-- ===== Little Will (digital port 7) ===== -->
      <LittleWillCmd little_will_active="true"/>
      <WaitCmd seconds="2.0"
        shutoff_motors="true"/>
      <LittleWillCmd little_will_active="false"/>
      <WaitCmd seconds="2.0"
        shutoff_motors="true"/>

      <!-- Hold here so the tree doesn't loop/restart while observing -->
      <WaitCmd seconds="200.0"
        shutoff_motors="true"/>
    </Sequence>
  </BehaviorTree>
</root>
