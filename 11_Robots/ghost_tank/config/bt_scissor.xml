<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="deploy_scissor">
    <Sequence>
          <!-- <SetBlackboard value="false" output_key="shoot"/> -->

      <ClimbCmd climb_extended="true"/>
      <WaitCmd seconds="0.8" shutoff_motors="false" />
      <MoveScissor scissor_position_in="12" offset="1" timeout_ms="1000"/>
      <ClimbCmd climb_extended="false"/>
      <WaitCmd seconds="0.5" shutoff_motors="false" />
      <MoveScissor scissor_position_in="8" offset="1" timeout_ms="1000"/>
      <!-- <ClimbCmd climb_extended="true"/>
      <WaitCmd seconds="0.2" shutoff_motors="false" />
      <ClimbCmd climb_extended="false"/>
      <MoveScissor scissor_position_in="16" offset="1" timeout_ms="5000"/>
      <WaitCmd seconds="0.2" shutoff_motors="false" />
      <SetBlackboard value="false" output_key="shoot"/> -->
      <ShutoffNode/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="BiteCmd"
            editable="true">
      <input_port name="bite_closed"/>
    </Action>
    <Action ID="ClampCmd"
            editable="true">
      <input_port name="clamp_closed"/>
    </Action>
    <Action ID="ClimbCmd"
            editable="true">
      <input_port name="climb_extended"/>
    </Action>
    <Action ID="ConveyorCmd"
            editable="true">
      <input_port name="fwd"/>
    </Action>
    <Action ID="GoalRushCmd"
            editable="true">
      <input_port name="arm_down"/>
    </Action>
    <Action ID="SetMirrored"
            editable="true">
      <input_port name="mirrored"/>
    </Action>
    <Action ID="IntakeCmd"
            editable="true">
      <input_port name="active"/>
    </Action>
    <Action ID="Logging"
            editable="true">
      <input_port name="message"/>
    </Action>
    <Action ID="MoveToPoseBezier"
            editable="true">
      <input_port name="posX_tiles"/>
      <input_port name="posY_tiles"/>
      <input_port name="theta_deg"/>
      <input_port name="search_radius_tiles"/>
      <input_port name="xy_exit_threshold_tiles"/>
      <input_port name="angle_exit_threshold_deg"/>
      <input_port name="lin_vel_exit_threshold_tps"/>
      <input_port name="ang_vel_exit_threshold_dps"/>
      <input_port name="lead"/>
      <input_port name="max_speed_linear_percent"/>
      <input_port name="max_speed_angular_percent"/>
      <input_port name="timeout_ms"/>
      <input_port name="use_theta"/>
      <input_port name="backwards"/>
    </Action>
    <Action ID="MoveToPosePurepursuit"
            editable="true">
      <input_port name="fileName"/>
      <input_port name="angle_threshold"
                  default="5.0">m</input_port>
      <input_port name="threshold"
                  default="0.025">m</input_port>
      <input_port name="timeout"
                  default="5000">ms</input_port>
      <input_port name="use_theta"
                  default="false"/>
    </Action>
    <Action ID="ShutoffNode"
            editable="true"/>
    <Action ID="MoveScissor" editable="true">
      <input_port name="scissor_position_in" />
      <input_port name="offset" />
      <input_port name="timeout_ms" />
    </Action>
  </TreeNodesModel>

</root>