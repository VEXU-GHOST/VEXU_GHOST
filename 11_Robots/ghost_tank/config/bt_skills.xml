<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="skills">
    <Sequence>
      <SetMirrored mirrored="false"/>
      <SetColorTarget target_red="true"/>
      <IntakeCmd auto="true"
                 ground_intake="false"/>
      <BiteCmd bite_closed="true"/>

      <!-- mobile goal 1 -->
      <GenerateBezierPath end_x_tiles="1.0"
        end_y_tiles="2.0"
        end_theta_deg="160.0"
        lead_tiles="0.75"
        backwards="false"
        type="QUADRATIC_BEZIER"
        num_points="250"/>
      <FollowPathPurePursuit xy_exit_threshold_tiles="0.1"
        angle_exit_threshold_deg="3.0"
        lin_vel_exit_threshold_tps="1.0"
        ang_vel_exit_threshold_dps="10.0"
        xy_settling_radius_tiles="0.0"
        max_speed_linear_percent="1.0"
        max_speed_angular_percent="1.0"
        timeout_ms="1500"
        use_theta="false"
        min_pursuit_radius_tiles="0.3"
        k_lookahead="0.3"
        deceleration_start_distance_tiles="1.0"
        deceleration_exponent="1.5"
        min_approach_velocity_tps="0.05"/>

      <ClampCmd clamp_closed="true"/>

      <!-- ring 1 -->
      <GenerateBezierPath end_x_tiles="1.0"
        end_y_tiles="1.0"
        end_theta_deg="180.0"
        lead_tiles="0.75"
        backwards="false"
        type="QUADRATIC_BEZIER"
        num_points="250"/>
      <FollowPathPurePursuit xy_exit_threshold_tiles="0.1"
        angle_exit_threshold_deg="3.0"
        lin_vel_exit_threshold_tps="1.0"
        ang_vel_exit_threshold_dps="10.0"
        xy_settling_radius_tiles="0.0"
        max_speed_linear_percent="1.0"
        max_speed_angular_percent="1.0"
        timeout_ms="1500"
        use_theta="false"
        min_pursuit_radius_tiles="0.3"
        k_lookahead="0.3"
        deceleration_start_distance_tiles="1.0"
        deceleration_exponent="1.5"
        min_approach_velocity_tps="0.05"/>
      
      <!-- /ring 2 -->
      <GenerateBezierPath end_x_tiles="2.0"
        end_y_tiles="2.0"
        end_theta_deg="-45.0"
        lead_tiles="0.75"
        backwards="false"
        type="QUADRATIC_BEZIER"
        num_points="250"/>
      <FollowPathPurePursuit xy_exit_threshold_tiles="0.1"
        angle_exit_threshold_deg="3.0"
        lin_vel_exit_threshold_tps="1.0"
        ang_vel_exit_threshold_dps="10.0"
        xy_settling_radius_tiles="0.0"
        max_speed_linear_percent="1.0"
        max_speed_angular_percent="1.0"
        timeout_ms="1500"
        use_theta="false"
        min_pursuit_radius_tiles="0.3"
        k_lookahead="0.3"
        deceleration_start_distance_tiles="1.0"
        deceleration_exponent="1.5"
        min_approach_velocity_tps="0.05"/>

        <!-- /ring 3 -->
        <GenerateBezierPath end_x_tiles="3.0"
        end_y_tiles="1.0"
        end_theta_deg="-135.0"
        lead_tiles="0.75"
        backwards="false"
        type="QUADRATIC_BEZIER"
        num_points="250"/>
      <FollowPathPurePursuit xy_exit_threshold_tiles="0.1"
        angle_exit_threshold_deg="3.0"
        lin_vel_exit_threshold_tps="1.0"
        ang_vel_exit_threshold_dps="10.0"
        xy_settling_radius_tiles="0.0"
        max_speed_linear_percent="1.0"
        max_speed_angular_percent="1.0"
        timeout_ms="1500"
        use_theta="false"
        min_pursuit_radius_tiles="0.3"
        k_lookahead="0.3"
        deceleration_start_distance_tiles="1.0"
        deceleration_exponent="1.5"
        min_approach_velocity_tps="0.05"/>

      <!-- /ring 4 -->
      <GenerateBezierPath end_x_tiles="4.0"
        end_y_tiles="2.0"
        end_theta_deg="-45.0"
        lead_tiles="0.75"
        backwards="false"
        type="QUADRATIC_BEZIER"
        num_points="250"/>
      <FollowPathPurePursuit xy_exit_threshold_tiles="0.1"
        angle_exit_threshold_deg="3.0"
        lin_vel_exit_threshold_tps="1.0"
        ang_vel_exit_threshold_dps="10.0"
        xy_settling_radius_tiles="0.0"
        max_speed_linear_percent="1.0"
        max_speed_angular_percent="1.0"
        timeout_ms="1500"
        use_theta="false"
        min_pursuit_radius_tiles="0.3"
        k_lookahead="0.3"
        deceleration_start_distance_tiles="1.0"
        deceleration_exponent="1.5"
        min_approach_velocity_tps="0.05"/>

      <!-- /ring 5 -->
      <GenerateBezierPath end_x_tiles="5.0"
        end_y_tiles="1.0"
        end_theta_deg="-135.0"
        lead_tiles="0.75"
        backwards="false"
        type="QUADRATIC_BEZIER"
        num_points="250"/>
      <FollowPathPurePursuit xy_exit_threshold_tiles="0.1"
        angle_exit_threshold_deg="3.0"
        lin_vel_exit_threshold_tps="1.0"
        ang_vel_exit_threshold_dps="10.0"
        xy_settling_radius_tiles="0.0"
        max_speed_linear_percent="1.0"
        max_speed_angular_percent="1.0"
        timeout_ms="1500"
        use_theta="false"
        min_pursuit_radius_tiles="0.3"
        k_lookahead="0.3"
        deceleration_start_distance_tiles="1.0"
        deceleration_exponent="1.5"
        min_approach_velocity_tps="0.05"/>

      <!-- /ring 6 -->
      <GenerateBezierPath end_x_tiles="6.0"
        end_y_tiles="0.0"
        end_theta_deg="-135.0"
        lead_tiles="0.75"
        backwards="false"
        type="QUADRATIC_BEZIER"
        num_points="250"/>
      <FollowPathPurePursuit xy_exit_threshold_tiles="0.1"
        angle_exit_threshold_deg="3.0"
        lin_vel_exit_threshold_tps="1.0"
        ang_vel_exit_threshold_dps="10.0"
        xy_settling_radius_tiles="0.0"
        max_speed_linear_percent="1.0"
        max_speed_angular_percent="1.0"
        timeout_ms="1500"
        use_theta="false"
        min_pursuit_radius_tiles="0.3"
        k_lookahead="0.3"
        deceleration_start_distance_tiles="1.0"
        deceleration_exponent="1.5"
        min_approach_velocity_tps="0.05"/>

      <!-- DROP OFF GOAL AT + CORNER -->
      <TurnToPoint posX_tiles="6.0"
        posY_tiles="0.0"
        timeout_ms="2000"
        backwards="true"
        angle_exit_threshold_deg="1.0"/>
      
      <ClampCmd clamp_closed="true"/>

    </Sequence>
  </BehaviorTree>

</root>
