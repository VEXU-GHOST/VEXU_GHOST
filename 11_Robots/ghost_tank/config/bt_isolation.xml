<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="main_tree">
  <!-- <include path="bt_goal_rush.xml"/> -->
  <include path="worlds/bt_worlds_goal_rush_omega.xml" />
  <include path="worlds/bt_center_rush_after_side_rush.xml"/>
  <include path="worlds/bt_grab_goal_after_rush.xml"/>
  <include path="bt_clear_corner.xml"/>
  <!-- <include path="bt_skills.xml"/> -->
  <include path="bt_neutral_stake.xml"/>
  <include path="basic_auton_1_15size_before_neutral.xml"/>
  <include path="basic_auton_1_15size_end.xml"/>

  <BehaviorTree ID="main_tree">
    <Sequence>
      <Sequence>
        <Logging message="Starting main tree" />
        <!-- <SetMirrored mirrored="false" /> -->
        <SubTree ID="worlds_goal_rush" _autoremap="true"/>
        <!-- <SubTree ID="center_rush_after_side_rush" _autoremap="true"/> -->
        <!-- <SubTree ID="grab_goal_after_rush" _autoremap="true"/> -->
        <SubTree ID="basic_auton_1" _autoremap="true"/>
        <SubTree ID="basic_auton_1_end" _autoremap="true"/>
        <SubTree ID="neutral_stake" _autoremap="true"/>
      </Sequence>
      <WaitCmd seconds="500.0" shutoff_motors="true" />
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="test_color_sensor">
    <Sequence>
      <Logging message="Starting test_color_sensor tree"/>
      <SetMirrored mirrored="false"/>
      <GoalRushCmd goal_rush_down="true"/>
 
      <GoalRushDetected right="false" threshold="0.5"/>
      <GoalRushCmd goal_rush_down="false"/>
      <WaitCmd seconds="200.0"
                shutoff_motors="true"/>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="test_integral">
    <Sequence>
      <SetMirrored mirrored="false"/>
      <!-- <Logging message="test"/> -->
      <ParallelAll>
        <Fallback>
          <Timeout msec="600">
            <KeepRunningUntilFailure>
              <ClampCmd clamp_closed="false"/>
            </KeepRunningUntilFailure>
          </Timeout>
          <ClampCmd clamp_closed="true"/>
        </Fallback>
      <MoveToPoseBezier  posX_tiles="2.0"
                          posY_tiles="1.0"
                          theta_deg="45.0"
                          search_radius_tiles="0.2"
                          xy_exit_threshold_tiles="0.05"
                          angle_exit_threshold_deg="1.0"
                          lead="0.8"
                          max_speed_linear_percent="0.3"
                          max_speed_angular_percent="0.3"
                          timeout_ms="-5000"
                          use_theta="true"
                          backwards="false"/>
      </ParallelAll>
      <WaitCmd seconds="2.0"
                shutoff_motors="true"/>
      <ParallelAll>
        <Fallback>
          <Timeout msec="600">
            <KeepRunningUntilFailure>
              <ClampCmd clamp_closed="false"/>
            </KeepRunningUntilFailure>
          </Timeout>
          <ClampCmd clamp_closed="true"/>
        </Fallback>
        <MoveToPoseBezier  posX_tiles="2.0"
                          posY_tiles="1.0"
                          theta_deg="135.0"
                          search_radius_tiles="0.2"
                          xy_exit_threshold_tiles="0.1"
                          angle_exit_threshold_deg="1.0"
                          lead="0.8"
                          max_speed_linear_percent="0.3"
                          max_speed_angular_percent="0.3"
                          timeout_ms="-5000"
                          use_theta="true"
                          backwards="true"/>
      </ParallelAll>
      <WaitCmd seconds="2.0"
                shutoff_motors="true"/>
      <!-- <SubTree ID="goal_rush" _autoremap="true"/> -->
      
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="test_mirrored">
    <Sequence>
      <SetMirrored mirrored="true"/>
      <!-- <Logging message="test"/> -->
      <IntakeCmd auto="true"
                 ground_intake="false"/>
      <MoveToPoseBezier  posX_tiles="4.0"
                          posY_tiles="2.0"
                          theta_deg="135.0"
                          search_radius_tiles="0.2"
                          xy_exit_threshold_tiles="0.05"
                          angle_exit_threshold_deg="1.0"
                          lead="0.8"
                          max_speed_linear_percent="0.3"
                          max_speed_angular_percent="0.3"
                          timeout_ms="-5000"
                          use_theta="true"
                          backwards="false"/>
      <WaitCmd seconds="2.0"
                shutoff_motors="true"/>
      <MoveToPoseBezier  posX_tiles="5.0"
                          posY_tiles="1.0"
                          theta_deg="135.0"
                          search_radius_tiles="0.2"
                          xy_exit_threshold_tiles="0.1"
                          angle_exit_threshold_deg="1.0"
                          lead="0.8"
                          max_speed_linear_percent="0.3"
                          max_speed_angular_percent="0.3"
                          timeout_ms="-5000"
                          use_theta="true"
                          backwards="true"/>
      <WaitCmd seconds="2.0"
                shutoff_motors="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="test_rush">
    <Sequence>
      <!-- <Logging message="test"/> -->
      <GoalRushCmd goal_rush_down="true"/>
      <!-- <ReactiveFallback> -->
        <!-- <GoalRushDetected/> -->
        <WaitCmd seconds="3.0"
                shutoff_motors="true"/>
      <!-- </ReactiveFallback> -->
      <GoalRushCmd goal_rush_down="false"/>
      <WaitCmd seconds="1.0"
                shutoff_motors="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="test_intake">
    <Sequence>
      <Logging message="test"/>
      <BiteCmd bite_closed="true"/>
      <IntakeCmd auto="true"
                 ground_intake="false"
                 store_ring="false"/>
      <WaitCmd seconds="500.0"
               shutoff_motors="true"/>
    </Sequence>
  </BehaviorTree>


  <BehaviorTree ID="jerryiotest">
    <Sequence>
      <Logging message="test"/>
      <MoveToPosePurepursuit fileName="~/VEXU_GHOST/11_Robots/ghost_tank/config/path.txt"
                             angle_threshold="165.0"
                             threshold="0.2"
                             timeout="1000"
                             use_theta="false"/>
      <Logging message="testover"/>
      <ShutoffNode/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="BiteCmd"
            editable="true">
      <input_port name="bite_closed"/>
    </Action>
    <Action ID="ClampCmd"
            editable="true">
      <input_port name="clamp_closed"/>
    </Action>
    <Action ID="ConveyorCmd"
            editable="true">
      <input_port name="fwd"/>
    </Action>
    <Action ID="GoalRushCmd"
            editable="true">
      <input_port name="goal_rush_down"/>
    </Action>
    <Action ID="SetMirrored"
            editable="true">
      <input_port name="mirrored"/>
    </Action>
    <Action ID="SetColorTarget"
            editable="true">
      <input_port name="target_red"/>
    </Action>
    <Action ID="IntakeCmd"
            editable="true">
      <input_port name="auto"/>
      <input_port name="ground_intake"/>
    </Action>
    <Action ID="Logging"
            editable="true">
      <input_port name="message"/>
    </Action>
    <Action ID="MoveToPoseBoomerang"
            editable="true">
      <input_port name="posX_tiles"/>
      <input_port name="posY_tiles"/>
      <input_port name="theta_deg"/>
      <input_port name="search_radius_tiles"/>
      <input_port name="xy_exit_threshold_tiles"/>
      <input_port name="angle_exit_threshold_deg"/>
      <input_port name="lin_vel_exit_threshold_tps"/>
      <input_port name="ang_vel_exit_threshold_dps"/>
      <input_port name="lead"/>
      <input_port name="max_speed_linear_percent"/>
      <input_port name="max_speed_angular_percent"/>
      <input_port name="timeout_ms"/>
      <input_port name="use_theta"/>
      <input_port name="backwards"/>
    </Action>
    <Action ID="MoveToPoseBezier"
            editable="true">
      <input_port name="posX_tiles"/>
      <input_port name="posY_tiles"/>
      <input_port name="theta_deg"/>
      <input_port name="search_radius_tiles"/>
      <input_port name="xy_exit_threshold_tiles"/>
      <input_port name="angle_exit_threshold_deg"/>
      <input_port name="lin_vel_exit_threshold_tps"/>
      <input_port name="ang_vel_exit_threshold_dps"/>
      <input_port name="lead"/>
      <input_port name="max_speed_linear_percent"/>
      <input_port name="max_speed_angular_percent"/>
      <input_port name="timeout_ms"/>
      <input_port name="use_theta"/>
      <input_port name="backwards"/>
    </Action>
    <Action ID="MoveToPosePurepursuit"
            editable="true">
      <input_port name="fileName"/>
      <input_port name="angle_threshold"
                  default="5.0">m</input_port>
      <input_port name="threshold"
                  default="0.025">m</input_port>
      <input_port name="timeout"
                  default="5000">ms</input_port>
      <input_port name="use_theta"
                  default="false"/>
    </Action>
    <Action ID="ShutoffNode"
            editable="true"/>
  </TreeNodesModel>

</root>