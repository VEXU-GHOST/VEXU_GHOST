<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="main_tree">

  <!-- Includes -->
  <include path="worlds/bt_worlds_goal_rush.xml" />
  <!-- <include path="worlds/bt_center_rush_after_side_rush.xml"/> -->
  <!-- <include path="worlds/bt_grab_goal_after_rush.xml"/> -->
  <!-- <include path="bt_skills.xml" /> -->
  <include path="bt_scissor.xml" />

  <BehaviorTree ID="main_tree">
    <Fallback>
      <Sequence>
        <SubTree ID="hang_no_rush" _autoremap="true" />
        <!-- <SubTree ID="hang_with_rush" _autoremap="true" /> -->

        <!-- Prepare Buddy Climb -->
        <ClampCmd clamp_closed="true" />

        <WaitCmd seconds="500.0" shutoff_motors="true" />
      </Sequence>
      <WaitCmd seconds="500.0" shutoff_motors="true" />
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="hang_no_rush">
    <Sequence>
      <Logging message="hang_no_rush" />

      <!-- Engage Pneumatics -->
      <BiteCmd bite_closed="true" />
      <ClimbCmd climb_extended="true" />

      <!-- Go to Ladder -->
      <Logging message="going to ladder" />

      <!-- <GenerateBezierPath end_x_tiles="2.0"
          end_y_tiles="3.0"
          end_theta_deg="45.0"
          lead_tiles="0.7"
          backwards="false"
          type="QUADRATIC_BEZIER"
          num_points="250"/>
        <FollowPathPurePursuit xy_exit_threshold_tiles="0.15"
          angle_exit_threshold_deg="10.0"
          lin_vel_exit_threshold_tps="0.5"
          ang_vel_exit_threshold_dps="30.0"
          max_speed_linear_percent="0.8"
          max_speed_angular_percent="1.0"
          timeout_ms="1500"
          use_theta="true"
          min_pursuit_radius_tiles="0.3"
          k_lookahead="0.15"
          deceleration_start_distance_tiles="1.25"
          deceleration_exponent="1.5"
          min_approach_velocity_tps="0.05"/>  -->

      <MoveToPoint kp="2.5"
        kd="0.1"
        max_effort_percent="1.0"
        timeout_ms="1000"
        backwards="false"
        distance_tiles="1.2" />

      <ArcturnToPoint posX_tiles="2.5"
        posY_tiles="3.25"
        timeout_ms="1000"
        angle_exit_threshold_deg="5.0"
        ang_vel_exit_threshold_dps="10.0"
        drive_backwards="false"
        face_backwards="false" />

      <!-- Settling -->
      <Logging message="Settling" />
      <WaitCmd seconds="0.250" shutoff_motors="true" />

      <!-- Engage Ladder -->
      <SubTree ID="engage_ladder" _autoremap="true" />
    </Sequence>

  </BehaviorTree>

  <BehaviorTree ID="hang_with_rush">
    <Sequence>
      <Logging message="hang_with_rush" />

      <!-- Rush Goal -->
      <BiteCmd bite_closed="true" />
      <SubTree ID="worlds_goal_rush" _autoremap="true" />

      <!-- Go to Ladder -->
      <ClimbCmd climb_extended="true" />
      <SubTree ID="go_to_ladder_with_rush" _autoremap="true" />

      <!-- Engage Ladder -->
      <SubTree ID="engage_ladder" _autoremap="true" />
    </Sequence>

  </BehaviorTree>

  <BehaviorTree ID="engage_ladder">
    <Sequence>
      <Logging message="Engaging Ladder!" />
      <MoveVoltage forward_effort="0.75" angular_effort="0.0" timeout_ms="1000" />
      <ParallelAll>
        <MoveVoltage forward_effort="1.0" angular_effort="0.0" timeout_ms="1000" />
        <ClimbCmd climb_extended="false" />
      </ParallelAll>
      <SubTree ID="attempt_high_stake" _autoremap="true" />
    </Sequence>
  </BehaviorTree>


  <BehaviorTree ID="attempt_high_stake">
    <Fallback>
      <Sequence>
        <IsHanging vel_threshold_tps="3.0" test_thrust_pct="1.0" test_duration_ms="1000" />
        <Logging message="Success! Robot is hanging!" />
        <Logging message="Score the High Stake!" />
        <MoveScissor scissor_position_in="20" offset="1" timeout_ms="5000" />
      </Sequence>
      <Logging message="Failed! Robot is not hanging!" />
      <AlwaysSuccess name="Don't get DQed!" />
    </Fallback>
  </BehaviorTree>


  <BehaviorTree ID="test_is_hanging">
    <Fallback>
      <Sequence>
        <IsHanging vel_threshold_tps="3.0" test_thrust_pct="1.0" test_duration_ms="1000" />
        <Logging message="Success! Robot is hanging!" />
      </Sequence>
      <Logging message="Failed! Robot is not hanging!" />
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="go_to_ladder_with_rush">
    <Sequence>
      <Sequence>
        <Logging message="going to ladder" />
        <GenerateBezierPath end_x_tiles="2.0"
          end_y_tiles="2.0"
          end_theta_deg="45.0"
          lead_tiles="0.5"
          backwards="false"
          type="CUBIC_BEZIER"
          num_points="250" />
        <FollowPathPurePursuit xy_exit_threshold_tiles="0.1"
          angle_exit_threshold_deg="8.0"
          lin_vel_exit_threshold_tps="1.0"
          ang_vel_exit_threshold_dps="10.0"
          max_speed_linear_percent="0.7"
          max_speed_angular_percent="1.0"
          timeout_ms="1500"
          use_theta="true"
          min_pursuit_radius_tiles="0.3"
          k_lookahead="0.0"
          deceleration_start_distance_tiles="1.0"
          deceleration_exponent="1.5"
          min_approach_velocity_tps="0.05" />

        <TurnToPoint posX_tiles="3.0"
          posY_tiles="1.0"
          timeout_ms="1000"
          backwards="false"
          ang_vel_exit_threshold_dps="10.0"
          angle_exit_threshold_deg="1.0" />

        <GenerateBezierPath end_x_tiles="1.6"
          end_y_tiles="2.5"
          end_theta_deg="-45.0"
          lead_tiles="0.5"
          backwards="true"
          type="CUBIC_BEZIER"
          num_points="250" />
        <FollowPathPurePursuit xy_exit_threshold_tiles="0.1"
          angle_exit_threshold_deg="8.0"
          lin_vel_exit_threshold_tps="1.0"
          ang_vel_exit_threshold_dps="10.0"
          max_speed_linear_percent="0.8"
          max_speed_angular_percent="1.0"
          timeout_ms="1500"
          use_theta="true"
          min_pursuit_radius_tiles="0.3"
          k_lookahead="0.0"
          deceleration_start_distance_tiles="1.0"
          deceleration_exponent="1.5"
          min_approach_velocity_tps="0.05" />

        <TurnToPoint posX_tiles="2.1"
          posY_tiles="3.1"
          timeout_ms="1750"
          backwards="false"
          ang_vel_exit_threshold_dps="10.0"
          angle_exit_threshold_deg="1.0" />
        <MoveToPoint kp="5.0"
          kd="0.0"
          max_effort_percent="0.3"
          timeout_ms="1000"
          backwards="false"
          distance_tiles="0.5" />
      </Sequence>
      <!-- <WaitCmd seconds="500.0" shutoff_motors="true" /> -->
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="test_color_sensor">
    <Sequence>
      <MoveVoltage forward_effort="0.20" angular_effort="0.0" timeout_ms="700" />
      <Logging message="Starting test_color_sensor tree yo what the nut" />
      <SetMirrored mirrored="false" />
      <GoalRushCmd goal_rush_l_down="true" />
      <BiteCmd bite_closed="true" />
      <ParallelAll>
        <MoveVoltage forward_effort="0.20" angular_effort="0.0" timeout_ms="700" />

        <Sequence>
          <Logging message="what" />

          <WaitCmd seconds="0.35"
            shutoff_motors="false" />

          <Logging message="waited" />

          <Fallback name="GoalRushOrTimeout">
            <!-- Branch A: sensor working -->
            <Sequence name="IfSensorFunctional">
              <!-- Invert GoalRushDetected -->
              <Inverter>
                <Sequence>
                  <GoalRushDetected right="false" threshold="0.5" />
                  <Logging message="sensor no workie, there shouldn't be a goal yet" />
                </Sequence>
              </Inverter>
              <Logging message="sensor works" />
              <!-- Race: either detect or timeout -->
              <ReactiveFallback>
                <GoalRushDetected right="false" threshold="0.7" />
                <WaitCmd seconds="0.35" shutoff_motors="false" />
              </ReactiveFallback>
              <!-- <ReactiveFallback name="GoalRushOrTimeout">
                <! Branch A: goal‑rush detected >
                <Sequence name="OnGoalRush">
                  <GoalRushDetected right="false" threshold="0.7" />
                  <Logging message="🏃‍♂️ Goal rush detected—exiting early" />
                </Sequence>

                <! Branch B: timeout expired >
                <Sequence name="OnTimeout">
                  <WaitCmd seconds="0.35" shutoff_motors="false" />
                  <Logging message="⏱ Timeout reached—no goal rush" />
                </Sequence>
              </ReactiveFallback> -->
            </Sequence>
            <!-- Branch B: sensor failed, just wait -->
            <Logging message="just wait, sensor failed????" />
            <WaitCmd seconds="0.35" shutoff_motors="false" />
          </Fallback>

          <Logging message="ended" />
          <!-- 4. Ramp down -->
          <GoalRushCmd goal_rush_l_down="false" />
          <WaitCmd seconds="100" shutoff_motors="true" />
        </Sequence>
      </ParallelAll>
    </Sequence>
  </BehaviorTree>

