# Copy to `.env` (gitignored) to customize per-machine Compose behavior.
#   cp .env.example .env
#
# Compose auto-loads `.env` when it sits next to `docker-compose.yml`.

# Set to 0 if you want multi-host ROS 2 discovery on a LAN; default 1 keeps traffic local.
# ROS_LOCALHOST_ONLY=1

# Linux with a native display: DISPLAY is usually :0 (XWayland/Xorg). The compose file
# picks this up automatically from your shell env, so you normally don't set it here.
# Leave unset on macOS/Windows so Qt falls back to the bundled noVNC service.
# DISPLAY=:0
