<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="main">
  <BehaviorTree ID="main">
    <Sequence>
      <Logging message="test"/>
      <ClampCmd clamp_closed="true">
        <MoveToPoseBoomerang posX_tiles="2.0"
                            posY_tiles="1.0"
                            theta_deg="0.0"
                            search_radius_m="0.3"
                            threshold_m="0.10"
                            angle_threshold_deg="5.0"
                            threshold_vel_mps="0.05"
                            angle_threshold_vel_dps="5.0"
                            lead="0.5"
                            max_speed_linear_pct="1.0"
                            max_speed_angular_pct="1.0"
                            timeout_ms="5000"
                            use_theta="true"
                            backwards="true"/>
      </ClampCmd>
      <Logging message="testover"/>
      <ShutoffNode/>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="side">
    <Sequence>
      <Logging message="test"/>
      <MoveToPosePurepursuit fileName= "~/VEXU_GHOST/11_Robots/ghost_tank/config/path.txt"
                              threshold ="0.2"
                              angle_threshold= "165.0"
                              timeout= "1000"
                              />  
      <Logging message="testover"/>
      <ShutoffNode/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="Logging"
            editable="true">
      <input_port name="message"/>
    </Action>
    <Decorator ID="BiteCmd"
               editable="true">
      <input_port name="bite_closed"/>
    </Decorator>
    <Decorator ID="ClampCmd"
               editable="true">
      <input_port name="clamp_closed"/>
    </Decorator>
    <Action ID="MoveToPoseBoomerang"
            editable="true">
      <input_port name="posY_tiles"/>
      <input_port name="theta_deg"/>
      <input_port name="search_radius_m"/>
      <input_port name="threshold_m"/>
      <input_port name="angle_threshold_deg"/>
      <input_port name="threshold_vel_mps"/>
      <input_port name="angle_threshold_vel_dps"/>
      <input_port name="lead"/>
      <input_port name="max_speed_linear_pct"/>
      <input_port name="max_speed_angular_pct"/>
      <input_port name="timeout_ms"/>
      <input_port name="use_theta"/>
      <input_port name="backwards"/>
    </Action>
    <Action ID="MoveToPosePurepursuit"
            editable="true">
      <input_port name="fileName"></input_port>
      <input_port name="angle_threshold"
                  default="5.0">m</input_port>
      <input_port name="threshold"
                  default="0.025">m</input_port>
      <input_port name="timeout"
                  default="5000">ms</input_port>
      <input_port name="use_theta"
                  default="false"/>
    </Action>
  </TreeNodesModel>

</root>
