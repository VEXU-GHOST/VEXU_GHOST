[Unit]
Description="Service description"

[Service]
Type=simple
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=75
StandardOutput=journal
Environment="HOME=/home/ghost"
EnvironmentFile=/etc/environment
ExecStart=/home/ghost/VEXU_GHOST/scripts/hardware/launch_hardware.sh

[Install]
WantedBy=default.target

