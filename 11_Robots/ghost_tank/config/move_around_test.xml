<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"  main_tree_to_execute="move_around_test">
    <BehaviorTree ID="move_around_test">
        <Sequence>
            <GenerateBezierPath 
                end_x_tiles="0.75"
                end_y_tiles="1.75"
                end_theta_deg="115.0"
                lead_tiles="1.75"
                backwards="false"
                type="QUADRATIC_BEZIER"
                num_points="250"/>
            <FollowPathPurePursuit 
                xy_exit_threshold_tiles="0.25"
                angle_exit_threshold_deg="3.0"
                lin_vel_exit_threshold_tps="1.0"
                ang_vel_exit_threshold_dps="10.0"
                xy_settling_radius_tiles="0.0"
                max_speed_linear_percent="1.0"
                max_speed_angular_percent="1.0"
                timeout_ms="3500"
                use_theta="false"
                min_pursuit_radius_tiles="0.3"
                k_lookahead="0.3"
                deceleration_start_distance_tiles="1.0"
                deceleration_exponent="1.5"
                min_approach_velocity_tps="0.05"/>
        </Sequence>
    </BehaviorTree>

    <TreeNodesModel>
        <Action ID="BiteCmd"
          editable="true">
          <input_port name="bite_closed" />
        </Action>
        <Action ID="ClampCmd"
          editable="true">
          <input_port name="clamp_closed" />
        </Action>
        <Action ID="ConveyorCmd"
          editable="true">
          <input_port name="fwd" />
        </Action>
        <Action ID="GoalRushCmd"
          editable="true">
          <input_port name="goal_rush_l_down" />
          <input_port name="goal_rush_r_down" />
        </Action>
        <Action ID="MoveScissor" editable="true">
          <input_port name="scissor_position_in" />
          <input_port name="offset" />
          <input_port name="timeout_ms" />
        </Action>
        <Action ID="SetMirrored"
          editable="true">
          <input_port name="mirrored" />
        </Action>
        <Action ID="SetColorTarget"
          editable="true">
          <input_port name="target_red" />
        </Action>
        <Action ID="IntakeCmd"
          editable="true">
          <input_port name="auto" />
          <input_port name="ground_intake" />
        </Action>
        <Action ID="Logging"
          editable="true">
          <input_port name="message" />
        </Action>
        <Action ID="MoveToPoseBezier"
          editable="true">
          <input_port name="posX_tiles" />
          <input_port name="posY_tiles" />
          <input_port name="theta_deg" />
          <input_port name="search_radius_tiles" />
          <input_port name="lead" />
          <input_port name="xy_exit_threshold_tiles" />
          <input_port name="angle_exit_threshold_deg" />
          <input_port name="lin_vel_exit_threshold_tps" />
          <input_port name="ang_vel_exit_threshold_dps" />
          <input_port name="max_speed_linear_percent" />
          <input_port name="max_speed_angular_percent" />
          <input_port name="timeout_ms" />
          <input_port name="use_theta" />
          <input_port name="backwards" />
        </Action>
        <Action ID="MoveVoltage" editable="true">
          <input_port name="forward_effort" />
          <input_port name="angular_effort" />
          <input_port name="timeout_ms" />
        </Action>
        <Action ID="ShutoffNode"
          editable="true" />
      </TreeNodesModel>




</root>