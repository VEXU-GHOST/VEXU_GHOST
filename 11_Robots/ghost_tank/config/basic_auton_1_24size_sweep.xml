<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="basic_auton_1">
    <Sequence>
    <!-- put donut on stick -->
      <Logging message="basic auton 1"/>
      <Logging message="Go to corner stack"/>
      <GoalRushCmd arm_down="true"
                  clamp="false"/>
      <MoveToPoseBezier posX_tiles="1.9"
                            posY_tiles="1.75"
                            theta_deg="-70.0"
                            search_radius_m="0.3"
                            threshold_m="0.20"
                            angle_threshold_deg="3.0"
                            threshold_vel_mps="0.1"
                            angle_threshold_vel_dps="1.0"
                            lead="0.75"
                            max_speed_linear_pct="1.0"
                            max_speed_angular_pct="1.0"
                            timeout_ms="-2000"
                            use_theta="true"
                            backwards="true"/>
      <GoalRushCmd arm_down="false"
                  clamp="false"/>
      <Logging message="Back Up and Clamp Goal"/>
      <ParallelAll>
        <Fallback>
          <Delay delay_msec="1000">
            <!-- <KeepRunningUntilFailure> -->
              <ClampCmd clamp_closed="false"/>
            <!-- </KeepRunningUntilFailure> -->
          </Delay>
            <ClampCmd clamp_closed="true"/>
        </Fallback>
        <MoveToPoseBezier posX_tiles="1.7"
                            posY_tiles="2.7"
                            theta_deg="-90.0"
                            search_radius_m="0.3"
                            threshold_m="0.05"
                            angle_threshold_deg="3.0"
                            threshold_vel_mps="0.1"
                            angle_threshold_vel_dps="1.0"
                            lead="1.0"
                            max_speed_linear_pct="0.4"
                            max_speed_angular_pct="1.0"
                            timeout_ms="-2000"
                            use_theta="true"
                            backwards="true"/>
      </ParallelAll>
      <GoalRushCmd arm_down="false"
                  clamp="false"/>
      <ClampCmd clamp_closed="true"/>
      <!-- donut on stick goal -->


      <Logging message="grab donut adjacent to goal"/>
      <IntakeCmd auto="true"
                 ground_intake="false"/>
      <MoveToPoseBezier posX_tiles="0.1"
                            posY_tiles="3"
                            theta_deg="180.0"
                            search_radius_m="0.3"
                            threshold_m="0.05"
                            angle_threshold_deg="3.0"
                            threshold_vel_mps="0.1"
                            angle_threshold_vel_dps="1.0"
                            lead="0.5"
                            max_speed_linear_pct="1.0"
                            max_speed_angular_pct="1.0"
                            timeout_ms="-2000"
                            use_theta="false"
                            backwards="false"/>
      <BiteCmd bite_closed="true"/>
      <ShutoffNode/>
      <!-- <WaitCmd seconds="100.00" -->
                <!-- shutoff_motors="true"/> -->
      
      <ShutoffNode/>
      <Logging message="go to clear stack start position"/>
      <IntakeCmd auto="true"
                 ground_intake="false"/>
      <MoveToPoseBezier posX_tiles="1.0"
                              posY_tiles="1.0"
                              theta_deg="-90.0"
                              search_radius_m="0.05"
                              threshold_m="0.02"
                              angle_threshold_deg="1.0"
                              threshold_vel_mps="0.1"
                              angle_threshold_vel_dps="1.0"
                              lead="0.5"
                              max_speed_linear_pct="0.8"
                              max_speed_angular_pct="1.0"
                              timeout_ms="-2000"
                              use_theta="true"
                              backwards="false"/>
      <ShutoffNode/>
      

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="BiteCmd"
            editable="true">
      <input_port name="bite_closed"/>
    </Action>
    <Action ID="ClampCmd"
            editable="true">
      <input_port name="clamp_closed"/>
    </Action>
    <Action ID="ConveyorCmd"
            editable="true">
      <input_port name="fwd"/>
    </Action>
    <Action ID="GoalRushCmd"
            editable="true">
      <input_port name="arm_down"/>
    </Action>
    <Action ID="SetMirrored"
            editable="true">
      <input_port name="mirrored"/>
    </Action>
    <Action ID="IntakeCmd"
            editable="true">
      <input_port name="active"/>
    </Action>
    <Action ID="Logging"
            editable="true">
      <input_port name="message"/>
    </Action>
    <Action ID="MoveToPoseBezier"
            editable="true">
      <input_port name="posX_tiles"/>
      <input_port name="posY_tiles"/>
      <input_port name="theta_deg"/>
      <input_port name="search_radius_m"/>
      <input_port name="threshold_m"/>
      <input_port name="angle_threshold_deg"/>
      <input_port name="threshold_vel_mps"/>
      <input_port name="angle_threshold_vel_dps"/>
      <input_port name="lead"/>
      <input_port name="max_speed_linear_pct"/>
      <input_port name="max_speed_angular_pct"/>
      <input_port name="timeout_ms"/>
      <input_port name="use_theta"/>
      <input_port name="backwards"/>
    </Action>
    <Action ID="MoveToPosePurepursuit"
            editable="true">
      <input_port name="fileName"/>
      <input_port name="angle_threshold"
                  default="5.0">m</input_port>
      <input_port name="threshold"
                  default="0.025">m</input_port>
      <input_port name="timeout"
                  default="5000">ms</input_port>
      <input_port name="use_theta"
                  default="false"/>
    </Action>
    <Action ID="ShutoffNode"
            editable="true"/>
  </TreeNodesModel>

</root>