<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="center_goal">
    <Sequence>
      <Logging message="Going to goal"/>
      <BiteCmd bite_closed="false"/>
      <ClampCmd clamp_closed="false"/>

      <MoveToPoseBezier posX_tiles="2.5"
                            posY_tiles="1.0"
                            theta_deg="180.0"
                            search_radius_tiles="0.5"
                            xy_exit_threshold_tiles="0.05"
                            angle_exit_threshold_deg="3.0"
                            lin_vel_exit_threshold_tps="0.1"
                            ang_vel_exit_threshold_dps="1.0"
                            lead="1.0"
                            max_speed_linear_percent="1.0"
                            max_speed_angular_percent="1.0"
                            timeout_ms="-2000"
                            use_theta="true"
                            backwards="true"/>
      <BiteCmd bite_closed="true"/>
      <GoalRushCmd goal_rush_down="false"/>

      <Logging message="Back Up Further and Clamp Goal"/>
      <ParallelAll>
        <Fallback>
          <Timeout msec="800">
            <KeepRunningUntilFailure>
              <Sequence>
                <ClampCmd clamp_closed="false"/>
                <GoalRushCmd goal_rush_down="false"/>
              </Sequence>
            </KeepRunningUntilFailure>
          </Timeout>
          <ClampCmd clamp_closed="true"/>
        </Fallback>
        <!-- <MoveToPoseBezier posX_tiles="3.2"
                            posY_tiles="0.9"
                            theta_deg="180.0"
                            search_radius_tiles= "0.3"
                            xy_exit_threshold_tiles="0.05"
                            angle_exit_threshold_deg="3.0"
                            lin_vel_exit_threshold_tps="0.1"
                            ang_vel_exit_threshold_dps="1.0"
                            lead="1.0"
                            max_speed_linear_percent="0.3"
                            max_speed_angular_percent="1.0"
                            timeout_ms="-2500"
                            use_theta="true"
                            backwards="true"/> -->
        <MoveToPoint 
          kp="2.0"
          kd="0.0"
          max_effort_percent="-0.4"
          timeout_ms="1500"
          xy_exit_threshold_tiles="1.0"/>
      </ParallelAll>
      <ClampCmd clamp_closed="true"/>

      <WaitCmd seconds="0.100"
                shutoff_motors="true"/>
      <!-- <ConveyorCmd fwd="true"/> -->
      <IntakeCmd auto="true"
          ground_intake="false"/>
      <ShutoffNode/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="BiteCmd"
            editable="true">
      <input_port name="bite_closed"/>
    </Action>
    <Action ID="ClampCmd"
            editable="true">
      <input_port name="clamp_closed"/>
    </Action>
    <Action ID="ConveyorCmd"
            editable="true">
      <input_port name="fwd"/>
    </Action>
    <Action ID="GoalRushCmd"
            editable="true">
      <input_port name="goal_rush_down"/>
    </Action>
    <Action ID="SetMirrored"
            editable="true">
      <input_port name="mirrored"/>
    </Action>
    <Action ID="IntakeCmd"
            editable="true">
      <input_port name="active"/>
    </Action>
    <Action ID="Logging"
            editable="true">
      <input_port name="message"/>
    </Action>
    <Action ID="MoveToPoseBezier"
            editable="true">
      <input_port name="posX_tiles"/>
      <input_port name="posY_tiles"/>
      <input_port name="theta_deg"/>
      <input_port name="search_radius_tiles"/>
      <input_port name="xy_exit_threshold_tiles"/>
      <input_port name="angle_exit_threshold_deg"/>
      <input_port name="lin_vel_exit_threshold_tps"/>
      <input_port name="ang_vel_exit_threshold_dps"/>
      <input_port name="lead"/>
      <input_port name="max_speed_linear_percent"/>
      <input_port name="max_speed_angular_percent"/>
      <input_port name="timeout_ms"/>
      <input_port name="use_theta"/>
      <input_port name="backwards"/>
    </Action>
    <Action ID="MoveToPosePurepursuit"
            editable="true">
      <input_port name="fileName"/>
      <input_port name="angle_threshold"
                  default="5.0">m</input_port>
      <input_port name="threshold"
                  default="0.025">m</input_port>
      <input_port name="timeout"
                  default="5000">ms</input_port>
      <input_port name="use_theta"
                  default="false"/>
    </Action>
    <Action ID="ShutoffNode"
            editable="true"/>
    <Action ID="NeutralStakeCmd"
            editable="true">
      <input_port name="state"/>
      <input_port name="timeout"/>
    </Action>
  </TreeNodesModel>

</root>