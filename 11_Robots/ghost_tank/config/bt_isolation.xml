<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
  main_tree_to_execute="main_tree">
  <!-- <include path="bt_goal_rush.xml"/> -->
  <!-- <include path="worlds/bt_worlds_goal_rush_omega.xml" /> -->
  <!-- <include path="worlds/bt_center_rush_after_side_rush.xml"/> -->
  <!-- <include path="worlds/bt_grab_goal_after_rush.xml"/> -->
  <include path="bt_clear_corner.xml"/>
  <include path="bt_corner_shove.xml"/>
  <include path="bt_get_second_goal.xml"/>
  <include path="bt_intake_middle_ring.xml"/>
  <include path="bt_grab_top_ring_neg_stack.xml"/>
  <!-- <include path="bt_skills.xml"/> -->

  <BehaviorTree ID="main_tree">
    <Sequence>
      <Sequence>
        <Logging message="Starting main tree" />
        <SubTree ID="win_point"
          _autoremap="true"/>
        <SubTree ID="grab_middle_goal"
          _autoremap="true"/>
        <ClampCmd clamp_closed="true"/>
        <BiteCmd bite_closed="true"/>
        <SubTree ID="clear_negative_corner"
          _autoremap="true"/>
        <SubTree ID="intake_middle_ring" _autoremap="true"/>

        <!-- <SubTree ID="skip_middle_ring"
          _autoremap="true"/> -->

        <SetMirrored mirrored="true"/>
        <SubTree ID="clear_negative_corner"
          _autoremap="true"/>

        <SubTree ID="corner_shove"
          _autoremap="true"/>
        <SubTree ID="get_far_goal"
          _autoremap="true"/>
        <SetMirrored mirrored="false"/>
        
      </Sequence>
      <WaitCmd seconds="500.0"
        shutoff_motors="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="test_arc_turns">
    <Sequence>
      <ArcturnToPoint posX_tiles="3.0"
        posY_tiles="2.0"
        timeout_ms="3000"
        angle_exit_threshold_deg="1.0"
        ang_vel_exit_threshold_dps="10.0"
        drive_backwards="false"
        face_backwards="false"/>
      <WaitCmd seconds="1.0"
        shutoff_motors="true"/>

      <ArcturnToPoint posX_tiles="0.0"
        posY_tiles="0.0"
        timeout_ms="3000"
        angle_exit_threshold_deg="1.0"
        ang_vel_exit_threshold_dps="10.0"
        drive_backwards="false"
        face_backwards="true"/>
      <WaitCmd seconds="1.0"
        shutoff_motors="true"/>

      <ArcturnToPoint posX_tiles="0.0"
        posY_tiles="6.0"
        timeout_ms="3000"
        angle_exit_threshold_deg="1.0"
        ang_vel_exit_threshold_dps="10.0"
        drive_backwards="true"
        face_backwards="false"/>
      <WaitCmd seconds="1.0"
        shutoff_motors="true"/>

      <ArcturnToPoint posX_tiles="3.0"
        posY_tiles="3.0"
        timeout_ms="3000"
        angle_exit_threshold_deg="1.0"
        ang_vel_exit_threshold_dps="10.0"
        drive_backwards="true"
        face_backwards="true"/>
      <WaitCmd seconds="1.0"
        shutoff_motors="true"/>
    </Sequence>

  </BehaviorTree>


  <BehaviorTree ID="test_new_mtp">
    <Sequence>
      <GenerateBezierPath end_x_tiles="0.75"
        end_y_tiles="1.75"
        end_theta_deg="115.0"
        lead_tiles="1.75"
        backwards="false"
        type="QUADRATIC_BEZIER"
        num_points="250"/>
      <FollowPathPurePursuit xy_exit_threshold_tiles="0.25"
        angle_exit_threshold_deg="3.0"
        lin_vel_exit_threshold_tps="1.0"
        ang_vel_exit_threshold_dps="10.0"
        xy_settling_radius_tiles="0.0"
        max_speed_linear_percent="1.0"
        max_speed_angular_percent="1.0"
        timeout_ms="3500"
        use_theta="false"
        min_pursuit_radius_tiles="0.3"
        k_lookahead="0.3"
        deceleration_start_distance_tiles="1.0"
        deceleration_exponent="1.5"
        min_approach_velocity_tps="0.05"/>

      <GenerateBezierPath end_x_tiles="1.5"
        end_y_tiles="1.5"
        end_theta_deg="-135.0"
        lead_tiles="0.5"
        backwards="true"
        type="QUADRATIC_BEZIER"
        num_points="250"/>
      <FollowPathPurePursuit xy_exit_threshold_tiles="0.15"
        angle_exit_threshold_deg="5.0"
        lin_vel_exit_threshold_tps="1.0"
        ang_vel_exit_threshold_dps="20.0"
        xy_settling_radius_tiles="0.0"
        max_speed_linear_percent="0.5"
        max_speed_angular_percent="1.0"
        timeout_ms="3500"
        use_theta="false"
        min_pursuit_radius_tiles="0.2"
        k_lookahead="0.0"
        deceleration_start_distance_tiles="1.0"
        deceleration_exponent="1.5"
        min_approach_velocity_tps="0.05"/>

      <GenerateBezierPath end_x_tiles="0.75"
        end_y_tiles="0.75"
        end_theta_deg="-135.0"
        lead_tiles="0.25"
        backwards="false"
        type="CUBIC_BEZIER"
        num_points="250"/>
      <FollowPathPurePursuit xy_exit_threshold_tiles="0.1"
        angle_exit_threshold_deg="5.0"
        lin_vel_exit_threshold_tps="1.0"
        ang_vel_exit_threshold_dps="20.0"
        xy_settling_radius_tiles="0.0"
        max_speed_linear_percent="0.5"
        max_speed_angular_percent="1.0"
        timeout_ms="2000"
        use_theta="true"
        min_pursuit_radius_tiles="0.2"
        k_lookahead="0.0"
        deceleration_start_distance_tiles="1.0"
        deceleration_exponent="1.5"
        min_approach_velocity_tps="0.05"/>


      <WaitCmd seconds="1.0"
        shutoff_motors="true" />
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="win_point">
    <Sequence>
      <Logging message="Starting winpoint"/>
      <NeutralStakeCmd state="3"
        timeout_ms="2000"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="grab_middle_goal">
    <Sequence>
      <ClampCmd clamp_closed="false"/>
      <NeutralStakeCmd state="2"
      timeout_ms="10"/>
      
      <Parallel failure_count="2" success_count="1">
        <Sequence>
          <ArcturnToPoint posX_tiles="6.0"
            posY_tiles="0.9"
            timeout_ms="3000"
            angle_exit_threshold_deg="3.0"
            ang_vel_exit_threshold_dps="40.0"
            drive_backwards="true"
            face_backwards="true"/>
          <MoveToPoint kp="5.0"
            kd="0.0"
            max_effort_percent="0.4"
            timeout_ms="1500"
            backwards="true"
            distance_tiles="0.7"/>
        </Sequence>
        <Fallback>
          <Sequence>
            <Delay delay_msec="500">
              <RetryUntilSuccessful num_attempts="-1">
                <GoalDetected threshold="0.65" />
              </RetryUntilSuccessful>
            </Delay>
            <Logging message="Goal detected!" />
          </Sequence>
          <Logging message="Goal detection failed" />
        </Fallback>
      </Parallel>

      <MoveToPoint kp="3.0"
        kd="0.0"
        max_effort_percent="0.2"
        timeout_ms="1500"
        backwards="true"
        distance_tiles="0.4"/>
      <ClampCmd clamp_closed="true"/>
      <BiteCmd bite_closed="true"/>
      <IntakeCmd auto="true"
        ground_intake="false"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="test_turn">
    <Sequence>
      <Logging message="Starting turn"/>
      <TurnToPoint posX_tiles="0.0"
        posY_tiles="0.0"
        timeout_ms="2000"
        backwards="false"
        angle_exit_threshold_deg="1.0"/>
      <Logging message="done"/>
      <TurnToPoint posX_tiles="1.0"
        posY_tiles="3.0"
        timeout_ms="2000"
        backwards="true"
        angle_exit_threshold_deg="1.0"/>
      <WaitCmd seconds="500.0"
        shutoff_motors="true" />
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="test_conveyor">
    <Sequence>
      <Logging message="Starting conveyor"/>
      <ConveyorCmd fwd="true"/>
      <WaitCmd seconds="0.5"
        shutoff_motors="true"/>
      <Logging message="stopping conveyor"/>
      <ConveyorCmd fwd="false"/>
      <WaitCmd seconds="0.5"
        shutoff_motors="true"/>
      <IntakeCmd auto="true"
        ground_intake="false"/>
      <WaitCmd seconds="0.5"
        shutoff_motors="true"/>
      <IntakeCmd auto="false"
        ground_intake="false"/>
      <WaitCmd seconds="0.5"
        shutoff_motors="true"/>
      <!-- <ForceSuccess>
        <Timeout msec="1000"> 
          <KeepRunningUntilFailure>
            <ConveyorCmd fwd="true"/>
          </KeepRunningUntilFailure>
        </Timeout>
      </ForceSuccess> -->
      <!-- <WaitCmd seconds="1.0" shutoff_motors="true"/> -->
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="test_color_sensor">
    <Sequence>
      <Logging message="Starting test_color_sensor tree"/>
      <SetMirrored mirrored="false"/>
      <GoalRushCmd goal_rush_down="true"/>

      <GoalRushDetected right="false"
        threshold="0.5"/>
      <GoalRushCmd goal_rush_down="false"/>
      <WaitCmd seconds="200.0"
        shutoff_motors="true"/>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="test_integral">
    <Sequence>
      <SetMirrored mirrored="false"/>
      <!-- <Logging message="test"/> -->
      <ParallelAll>
        <Fallback>
          <Timeout msec="600">
            <KeepRunningUntilFailure>
              <ClampCmd clamp_closed="false"/>
            </KeepRunningUntilFailure>
          </Timeout>
          <ClampCmd clamp_closed="true"/>
        </Fallback>
        <!-- <MoveToPoseBezier posX_tiles="2.0" posY_tiles="1.0" theta_deg="45.0" search_radius_tiles="0.2" xy_exit_threshold_tiles="0.05" angle_exit_threshold_deg="1.0" lead="0.8" max_speed_linear_percent="0.3" max_speed_angular_percent="0.3" timeout_ms="-5000" use_theta="true" backwards="false"/> -->
      </ParallelAll>
      <WaitCmd seconds="2.0"
        shutoff_motors="true"/>
      <ParallelAll>
        <Fallback>
          <Timeout msec="600">
            <KeepRunningUntilFailure>
              <ClampCmd clamp_closed="false"/>
            </KeepRunningUntilFailure>
          </Timeout>
          <ClampCmd clamp_closed="true"/>
        </Fallback>
        <!-- <MoveToPoseBezier posX_tiles="2.0" posY_tiles="1.0" theta_deg="135.0" search_radius_tiles="0.2" xy_exit_threshold_tiles="0.1" angle_exit_threshold_deg="1.0" lead="0.8" max_speed_linear_percent="0.3" max_speed_angular_percent="0.3" timeout_ms="-5000" use_theta="true" backwards="true"/> -->
      </ParallelAll>
      <WaitCmd seconds="2.0"
        shutoff_motors="true"/>
      <!-- <SubTree ID="goal_rush" _autoremap="true"/> -->

    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="test_mirrored">
    <Sequence>
      <SetMirrored mirrored="true"/>
      <!-- <Logging message="test"/> -->
      <IntakeCmd auto="true"
        ground_intake="false"/>
      <!-- <MoveToPoseBezier posX_tiles="4.0" posY_tiles="2.0" theta_deg="135.0" search_radius_tiles="0.2" xy_exit_threshold_tiles="0.05" angle_exit_threshold_deg="1.0" lead="0.8" max_speed_linear_percent="0.3" max_speed_angular_percent="0.3" timeout_ms="-5000" use_theta="true" backwards="false"/> -->
      <WaitCmd seconds="2.0"
        shutoff_motors="true"/>
      <!-- <MoveToPoseBezier posX_tiles="5.0" posY_tiles="1.0" theta_deg="135.0" search_radius_tiles="0.2" xy_exit_threshold_tiles="0.1" angle_exit_threshold_deg="1.0" lead="0.8" max_speed_linear_percent="0.3" max_speed_angular_percent="0.3" timeout_ms="-5000" use_theta="true" backwards="true"/> -->
      <WaitCmd seconds="2.0"
        shutoff_motors="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="test_rush">
    <Sequence>
      <!-- <Logging message="test"/> -->
      <GoalRushCmd goal_rush_down="true"/>
      <!-- <ReactiveFallback> -->
      <!-- <GoalRushDetected/> -->
      <WaitCmd seconds="3.0"
        shutoff_motors="true"/>
      <!-- </ReactiveFallback> -->
      <GoalRushCmd goal_rush_down="false"/>
      <WaitCmd seconds="1.0"
        shutoff_motors="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="test_intake">
    <Sequence>
      <Logging message="test"/>
      <BiteCmd bite_closed="true"/>
      <ClampCmd clamp_closed="true"/>
      <!-- <IntakeCmd auto="true"
        ground_intake="false"
        store_ring="true"/> -->
      <!-- <WaitCmd seconds="5.0"
        shutoff_motors="true"/> -->
      <IntakeCmd auto="true"
        ground_intake="false"
        store_ring="false"/>
      <WaitCmd seconds="200.0"
        shutoff_motors="true"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="BiteCmd"
      editable="true">
      <input_port name="bite_closed"/>
    </Action>
    <Action ID="ClampCmd"
      editable="true">
      <input_port name="clamp_closed"/>
    </Action>
    <Action ID="ConveyorCmd"
      editable="true">
      <input_port name="fwd"/>
    </Action>
    <Action ID="GoalRushCmd"
      editable="true">
      <input_port name="goal_rush_down"/>
    </Action>
    <Action ID="SetMirrored"
      editable="true">
      <input_port name="mirrored"/>
    </Action>
    <Action ID="SetColorTarget"
      editable="true">
      <input_port name="target_red"/>
    </Action>
    <Action ID="IntakeCmd"
      editable="true">
      <input_port name="auto"/>
      <input_port name="ground_intake"/>
    </Action>
    <Action ID="Logging"
      editable="true">
      <input_port name="message"/>
    </Action>
    <Action ID="GenerateBezierPath"
      editable="true">
      <input_port name="end_x_tiles"/>
      <input_port name="end_y_tiles"/>
      <input_port name="end_theta_deg"/>
      <input_port name="lead_tiles"/>
      <input_port name="backwards"
        default="false"/>
      <input_port name="type"
        default="CUBIC_BEZIER"/>
      <input_port name="num_points"
        default="250"/>
    </Action>
    <Action ID="FollowPathPurePursuit"
      editable="true">
      <input_port name="xy_exit_threshold_tiles"/>
      <input_port name="angle_exit_threshold_deg"/>
      <input_port name="lin_vel_exit_threshold_tps"/>
      <input_port name="ang_vel_exit_threshold_dps"/>
      <input_port name="xy_settling_radius_tiles"/>
      <input_port name="max_speed_linear_percent" />
      <input_port name="max_speed_angular_percent" />
      <input_port name="timeout_ms"/>
      <input_port name="use_theta"/>
      <input_port name="backwards"/>
      <input_port name="lookahead_distance_tiles"/>
      <input_port name="k_lookahead"/>
      <input_port name="min_lookahead_distance_tiles"/>
      <input_port name="deceleration_start_distance_tiles"/>
      <input_port name="deceleration_exponent"/>
      <input_port name="min_approach_velocity_tps"/>
    </Action>
    <Action ID="ShutoffNode"
      editable="true"/>
  </TreeNodesModel>

</root>