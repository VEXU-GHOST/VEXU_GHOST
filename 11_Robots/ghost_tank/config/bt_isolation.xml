                                theta_deg="0.0"
                                search_radius_m="0.3"
                                threshold_m="0.10"
                                angle_threshold_deg="5.0"
                                threshold_vel_mps="100.0"
                                angle_threshold_vel_dps="1000.0"
                                lead="1.0"
                                max_speed_linear_pct="1.0"
                                max_speed_angular_pct="1.0"
                                timeout_ms="-1000"
                                use_theta="true"
                                backwards="true"/>
        </ReactiveSequence>
        <ShutoffNode/>

        <ReactiveSequence>
          <IntakeCmd lower="true"
          red="false"/>
          <Delay delay_msec="1000">
          <ShutoffNode/>
          </Delay>
        </ReactiveSequence>

        <ReactiveSequence>
          <BiteCmd bite_closed="false"/>
          <IntakeCmd lower="true"
          red="false"/>
          <MoveToPoseBoomerang posX_tiles="1.2"
                                posY_tiles="1.8"
                                theta_deg="45.0"
                                search_radius_m="0.3"
                                threshold_m="0.10"
                                angle_threshold_deg="5.0"
                                threshold_vel_mps="100.0"
