<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="skills">
    <Sequence>
      <SetMirrored mirrored="false"/>
      <SetColorTarget target_red="true"/>
      <MoveToPoseBezier  posX_tiles="1.5"
                          posY_tiles="1.5"
                          theta_deg="135.0"
                          search_radius_tiles="0.3"
                          xy_exit_threshold_tiles="0.05"
                          angle_exit_threshold_deg="1.0"
                          lead="0.8"
                          max_speed_linear_percent="1.0"
                          max_speed_angular_percent="1.0"
                          timeout_ms="-2000"
                          use_theta="true"
                          backwards="false"/>
      <MoveToPoseBezier  posX_tiles="1.5"
                          posY_tiles="1.5"
                          theta_deg="-45.0"
                          search_radius_tiles="0.3"
                          xy_exit_threshold_tiles="0.05"
                          angle_exit_threshold_deg="1.0"
                          lead="0.8"
                          max_speed_linear_percent="1.0"
                          max_speed_angular_percent="1.0"
                          timeout_ms="-2000"
                          use_theta="true"
                          backwards="true"/>
      <MoveToPoseBezier  posX_tiles="1.0"
                          posY_tiles="2.0"
                          theta_deg="-45.0"
                          search_radius_tiles="0.3"
                          xy_exit_threshold_tiles="0.05"
                          angle_exit_threshold_deg="1.0"
                          lead="0.8"
                          max_speed_linear_percent="0.4"
                          max_speed_angular_percent="1.0"
                          timeout_ms="-3000"
                          use_theta="true"
                          backwards="true"/>
      <ClampCmd clamp_closed="true"/>
      <BiteCmd bite_closed="true"/>
      <IntakeCmd auto="true"
                 ground_intake="false"/>
      <MoveToPoseBezier  posX_tiles="1.0"
                          posY_tiles="1.0"
                          theta_deg="-135.0"
                          search_radius_tiles="0.3"
                          xy_exit_threshold_tiles="0.05"
                          angle_exit_threshold_deg="1.0"
                          lead="0.8"
                          max_speed_linear_percent="1.0"
                          max_speed_angular_percent="1.0"
                          timeout_ms="-3000"
                          use_theta="true"
                          backwards="false"/>
      <MoveToPoseBezier  posX_tiles="1.0"
                          posY_tiles="1.0"
                          theta_deg="90.0"
                          search_radius_tiles="0.3"
                          xy_exit_threshold_tiles="0.05"
                          angle_exit_threshold_deg="1.0"
                          lead="0.8"
                          max_speed_linear_percent="1.0"
                          max_speed_angular_percent="1.0"
                          timeout_ms="-3000"
                          use_theta="true"
                          backwards="false"/>
      <MoveToPoseBezier  posX_tiles="1.0"
                          posY_tiles="5.0"
                          theta_deg="90.0"
                          search_radius_tiles="0.3"
                          xy_exit_threshold_tiles="0.05"
                          angle_exit_threshold_deg="1.0"
                          lead="0.8"
                          max_speed_linear_percent="0.4"
                          max_speed_angular_percent="1.0"
                          timeout_ms="-10000"
                          use_theta="true"
                          backwards="false"/>
      <MoveToPoseBezier  posX_tiles="1.0"
                          posY_tiles="1.0"
                          theta_deg="90.0"
                          search_radius_tiles="0.3"
                          xy_exit_threshold_tiles="0.05"
                          angle_exit_threshold_deg="1.0"
                          lead="0.8"
                          max_speed_linear_percent="1.0"
                          max_speed_angular_percent="1.0"
                          timeout_ms="-3000"
                          use_theta="true"
                          backwards="true"/>
      <SubTree ID="corner_shove_skills" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="corner_shove_skills">
    <Sequence>
      <Repeat num_cycles="2">
        <Sequence>
      <MoveToPoseBezier
        posX_tiles="1.0"
        posY_tiles="1.0"
        theta_deg="45.0"
        search_radius_tiles="0.3"
        xy_exit_threshold_tiles="0.2"
        angle_exit_threshold_deg="3.0"
        lin_vel_exit_threshold_tps="0.1"
        ang_vel_exit_threshold_dps="1.0"
        lead="0.5"
        max_speed_linear_percent="1.0"
        max_speed_angular_percent="1.0"
        timeout_ms="-1000"
        use_theta="true"
        backwards="false"/>
      <ShutoffNode/>

      <MoveToPoseBezier
        posX_tiles="0.25"
        posY_tiles="0.25"
        theta_deg="45.0"
        search_radius_tiles="0.3"
        xy_exit_threshold_tiles="0.2"
        angle_exit_threshold_deg="3.0"
        lin_vel_exit_threshold_tps="0.1"
        ang_vel_exit_threshold_dps="1.0"
        lead="0.5"
        max_speed_linear_percent="1.0"
        max_speed_angular_percent="1.0"
        timeout_ms="-1000"
        use_theta="true"
        backwards="true"/>
      <ShutoffNode/>
      <ClampCmd clamp_closed="false"/>
        </Sequence>
      </Repeat>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Decorator ID="AutonTimer"
            editable="true">
      <input_port name="seconds"/>
    </Decorator>
    <Action ID="Logging"
            editable="true">
      <input_port name="message"/>
    </Action>
  </TreeNodesModel>

</root>
