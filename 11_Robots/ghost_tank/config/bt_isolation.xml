<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="goal_rush">
  <BehaviorTree ID="goal_rush">
    <Sequence>
      <SetMirrored mirrored="false"/>
      <Logging message="goal_rush"/>
      <GoalRushCmd arm_down="false"/>
      <MoveToPoseBoomerang  posX_tiles="1.5"
                            posY_tiles="2.35"
                            theta_deg="120.0"
                            search_radius_m="0.3"
                            threshold_m="0.1"
                            angle_threshold_deg="8.0"
                            threshold_vel_mps="100.0"
                            angle_threshold_vel_dps="1000.0"
                            lead="0.25"
                            max_speed_linear_pct="1.0"
                            max_speed_angular_pct="1.0"
                            timeout_ms="-5000"
                            use_theta="true"
                            backwards="false"/>
      <GoalRushCmd arm_down="true"/>
      <ShutoffNode/>
      <Delay delay_msec="250">
        <ShutoffNode/>
      </Delay>

      <Logging message="pulling_back"/>
      <MoveToPoseBoomerang posX_tiles="1.9"
                            posY_tiles="1.75"
                            theta_deg="-70.0"
                            search_radius_m="0.3"
                            threshold_m="0.20"
                            angle_threshold_deg="10.0"
                            threshold_vel_mps="100.0"
                            angle_threshold_vel_dps="1000.0"
                            lead="0.75"
                            max_speed_linear_pct="1.0"
                            max_speed_angular_pct="1.0"
                            timeout_ms="-5000"
                            use_theta="true"
                            backwards="true"/>
      <ShutoffNode/>

      <Logging message="retract arm"/>
      <GoalRushCmd arm_down="false"/>

      <MoveToPoseBoomerang posX_tiles="2.0"
                            posY_tiles="1.0"
                            theta_deg="-90.0"
                            search_radius_m="0.3"
                            threshold_m="0.10"
                            angle_threshold_deg="10.0"
                            threshold_vel_mps="100.0"
                            angle_threshold_vel_dps="20.0"
                            lead="0.75"
                            max_speed_linear_pct="1.0"
                            max_speed_angular_pct="1.0"
                            timeout_ms="-5000"
                            use_theta="true"
                            backwards="true"/>
      <ShutoffNode/>

      <Logging message="Going to goal"/>
      <BiteCmd bite_closed="true"/>
      <MoveToPoseBoomerang posX_tiles="2.2"
                            posY_tiles="1.0"
                            theta_deg="0.0"
                            search_radius_m="0.3"
                            threshold_m="0.10"
                            angle_threshold_deg="5.0"
                            threshold_vel_mps="100.0"
                            angle_threshold_vel_dps="20.0"
                            lead="1.0"
                            max_speed_linear_pct="1.0"
                            max_speed_angular_pct="1.0"
                            timeout_ms="-5000"
                            use_theta="true"
                            backwards="true"/>
      <ShutoffNode/>
      <BiteCmd bite_closed="true"/>

      <Logging message="Back Up Further and Clamp Goal"/>
      <MoveToPoseBoomerang posX_tiles="3.2"
                            posY_tiles="1.0"
                            theta_deg="0.0"
                            search_radius_m="0.3"
                            threshold_m="0.10"
                            angle_threshold_deg="5.0"
                            threshold_vel_mps="100.0"
                            angle_threshold_vel_dps="1000.0"
                            lead="1.0"
                            max_speed_linear_pct="0.4"
                            max_speed_angular_pct="1.0"
                            timeout_ms="-1000"
                            use_theta="true"
                            backwards="true"/>
      <ShutoffNode/>
      <ClampCmd clamp_closed="true"/>
      <Delay delay_msec="250">
        <ShutoffNode/>
      </Delay>

      <Logging message="Turn to face stack"/>
      <ReactiveSequence>
        <ConveyorCmd fwd="true"/>
        <MoveToPoseBoomerang posX_tiles="3.5"
                              posY_tiles="1.0"
                              theta_deg="45.0"
                              search_radius_m="0.3"
                              threshold_m="0.05"
                              angle_threshold_deg="5.0"
                              threshold_vel_mps="100.0"
                              angle_threshold_vel_dps="20.0"
                              lead="1.0"
                              max_speed_linear_pct="0.6"
                              max_speed_angular_pct="1.0"
                              timeout_ms="-1000"
                              use_theta="true"
                              backwards="true"/>
      </ReactiveSequence>
      <ConveyorCmd fwd="false"/>

      <Logging message="Grab Stack"/>
      <ReactiveSequence>
        <IntakeCmd lower="true" red="false"/>
        <Sequence>
          <Delay delay_msec="250">
            <ShutoffNode/>
          </Delay>  
          <MoveToPoseBoomerang posX_tiles="3.0"
                                posY_tiles="0.5"
                                theta_deg="-135.0"
                                search_radius_m="0.3"
                                threshold_m="0.10"
                                angle_threshold_deg="5.0"
                                threshold_vel_mps="100.0"
                                angle_threshold_vel_dps="1000.0"
                                lead="0.5"
                                max_speed_linear_pct="0.4"
                                max_speed_angular_pct="0.5"
                                timeout_ms="-1000"
                                use_theta="true"
                                backwards="false"/>
          <ShutoffNode/>

          <Logging message="Wait for Ring"/>
          <Delay delay_msec="500">
            <ShutoffNode/>
          </Delay>  

          <Logging message="Backup"/>
          <MoveToPoseBoomerang posX_tiles="3.5"
                          posY_tiles="1.0"
                          theta_deg="45.0"
                          search_radius_m="0.3"
                          threshold_m="0.10"
                          angle_threshold_deg="5.0"
                          threshold_vel_mps="100.0"
                          angle_threshold_vel_dps="1000.0"
                          lead="1.0"
                          max_speed_linear_pct="1.0"
                          max_speed_angular_pct="1.0"
                          timeout_ms="-1000"
                          use_theta="true"
                          backwards="true"/>
        </Sequence>
      </ReactiveSequence>
      <ShutoffNode/>
      <Delay delay_msec="500">
        <ShutoffNode/>
      </Delay>

      <Logging message="Go to stack"/>
      <BiteCmd bite_closed="false"/>
      <ReactiveSequence>
        <IntakeCmd lower="true" red="false"/>
        <Sequence>
          <Logging message="Go to next stack"/>
          <MoveToPoseBoomerang posX_tiles="2.2"
                                posY_tiles="1.0"
                                theta_deg="180.0"
                                search_radius_m="0.3"
                                threshold_m="0.05"
                                angle_threshold_deg="5.0"
                                threshold_vel_mps="100.0"
                                angle_threshold_vel_dps="30.0"
                                lead="0.5"
                                max_speed_linear_pct="1.0"
                                max_speed_angular_pct="1.0"
                                timeout_ms="-2000"
                                use_theta="true"
                                backwards="false"/>
          <ShutoffNode/>
          <Delay delay_msec="1000">
            <ShutoffNode/>
          </Delay>

          <Logging message="Approach Stack slowly"/>
          <MoveToPoseBoomerang posX_tiles="1.45"
                                posY_tiles="1.0"
                                theta_deg="180.0"
                                search_radius_m="0.3"
                                threshold_m="0.05"
                                angle_threshold_deg="5.0"
                                threshold_vel_mps="100.0"
                                angle_threshold_vel_dps="1000.0"
                                lead="0.0"
                                max_speed_linear_pct="0.5"
                                max_speed_angular_pct="1.0"
                                timeout_ms="-1000"
                                use_theta="true"
                                backwards="false"/>
          <ShutoffNode/>
          <Delay delay_msec="250">
            <ShutoffNode/>
          </Delay>


          <Logging message="Bite top ring"/>
          <BiteCmd bite_closed="true"/>
          <Delay delay_msec="375">
            <ShutoffNode/>
          </Delay>

          <Logging message="Backup"/>
          <MoveToPoseBoomerang posX_tiles="2.0"
                                posY_tiles="1.0"
                                theta_deg="0.0"
                                search_radius_m="0.3"
                                threshold_m="0.05"
                                angle_threshold_deg="5.0"
                                threshold_vel_mps="100.0"
                                angle_threshold_vel_dps="1000.0"
                                lead="0.0"
                                max_speed_linear_pct="0.5"
                                max_speed_angular_pct="1.0"
                                timeout_ms="-1000"
                                use_theta="false"
                                backwards="true"/>
          <ShutoffNode/>

          <Logging message="Grab Blue Ring"/>
          <MoveToPoseBoomerang posX_tiles="1.0"
                                posY_tiles="1.0"
                                theta_deg="180.0"
                                search_radius_m="0.3"
                                threshold_m="0.05"
                                angle_threshold_deg="5.0"
                                threshold_vel_mps="100.0"
                                angle_threshold_vel_dps="1000.0"
                                lead="0.0"
                                max_speed_linear_pct="0.3"
                                max_speed_angular_pct="1.0"
                                timeout_ms="-1000"
                                use_theta="false"
                                backwards="false"/>
          <ShutoffNode/>
          <Delay delay_msec="1000">
            <ShutoffNode/>
          </Delay>

          <Logging message="Turn to Next Stack"/>
          <BiteCmd bite_closed="false"/>
          <MoveToPoseBoomerang posX_tiles="1.0"
                                posY_tiles="1.0"
                                theta_deg="90.0"
                                search_radius_m="0.3"
                                threshold_m="0.2"
                                angle_threshold_deg="5.0"
                                threshold_vel_mps="100.0"
                                angle_threshold_vel_dps="1000.0"
                                lead="1.0"
                                max_speed_linear_pct="0.3"
                                max_speed_angular_pct="1.0"
                                timeout_ms="-1000"
                                use_theta="true"
                                backwards="false"/>
          <ShutoffNode/>
          <Delay delay_msec="250">
            <ShutoffNode/>
          </Delay>

          <MoveToPoseBoomerang posX_tiles="1.0"
                                posY_tiles="1.65"
                                theta_deg="90.0"
                                search_radius_m="0.3"
                                threshold_m="0.05"
                                angle_threshold_deg="5.0"
                                threshold_vel_mps="100.0"
                                angle_threshold_vel_dps="1000.0"
                                lead="1.0"
                                max_speed_linear_pct="0.3"
                                max_speed_angular_pct="1.0"
                                timeout_ms="-1000"
                                use_theta="true"
                                backwards="false"/>
          <ShutoffNode/>
          <Delay delay_msec="250">
            <ShutoffNode/>
          </Delay>

          <Logging message="Bite"/>
          <BiteCmd bite_closed="true"/>
          <Delay delay_msec="375">
            <ShutoffNode/>
          </Delay>

          <Logging message="Pull Back"/>
          <MoveToPoseBoomerang posX_tiles="1.0"
                                posY_tiles="1.0"
                                theta_deg="135.0"
                                search_radius_m="0.3"
                                threshold_m="0.05"
                                angle_threshold_deg="5.0"
                                threshold_vel_mps="100.0"
                                angle_threshold_vel_dps="1000.0"
                                lead="0.5"
                                max_speed_linear_pct="0.3"
                                max_speed_angular_pct="1.0"
                                timeout_ms="-1000"
                                use_theta="true"
                                backwards="false"/>
          <ShutoffNode/>

          <Logging message="Go to corner stack"/>
          <MoveToPoseBoomerang posX_tiles="0.75"
                                posY_tiles="0.75"
                                theta_deg="225.0"
                                search_radius_m="0.3"
                                threshold_m="0.05"
                                angle_threshold_deg="5.0"
                                threshold_vel_mps="100.0"
                                angle_threshold_vel_dps="1000.0"
                                lead="0.5"
                                max_speed_linear_pct="1.0"
                                max_speed_angular_pct="1.0"
                                timeout_ms="-1000"
                                use_theta="false"
                                backwards="false"/>
          <ShutoffNode/>
        </Sequence>
      </ReactiveSequence>

      <IntakeCmd lower="false" red="false"/>
      
        <!-- <ShutoffNode/>
        <Delay delay_msec="5000">
          <ShutoffNode/>
        </Delay>

        <ReactiveSequence>
          <IntakeCmd lower="true"
          red="false"/>
          <Delay delay_msec="1000">
            <ShutoffNode/>
          </Delay>
        </ReactiveSequence>

        <ReactiveSequence>
          <IntakeCmd lower="true" red="false"/>
          <MoveToPoseBoomerang posX_tiles="0.5"
                                posY_tiles="1.0"
                                theta_deg="180.0"
                                search_radius_m="0.3"
                                threshold_m="0.10"
                                angle_threshold_deg="5.0"
                                threshold_vel_mps="100.0"
                                angle_threshold_vel_dps="1000.0"
                                lead="1.0"
                                max_speed_linear_pct="0.4"
                                max_speed_angular_pct="1.0"
                                timeout_ms="-2000"
                                use_theta="true"
                                backwards="false"/>
        </ReactiveSequence>
        <ShutoffNode/>

        <ReactiveSequence>
          <IntakeCmd lower="true" red="false"/>
          <MoveToPoseBoomerang posX_tiles="1.75"
