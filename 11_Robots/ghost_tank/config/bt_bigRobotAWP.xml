      <WaitCmd seconds="3.0"/>
      <ClampCmd clamp_closed="true"/>
      <WaitCmd seconds="1.0"/>
      <LiftPosCmd stage="2"/>
      <WaitCmd seconds="2.0"/>
      <LiftPosCmd stage="1"/>
      <ClampCmd clamp_closed="false"/> -->
      
      <WaitCmd seconds="300000.0"/>
