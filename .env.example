# Copy to `.env` (gitignored) to customize per-machine Compose behavior.
#   cp .env.example .env
#
# Compose auto-loads `.env` when it sits next to `docker-compose.yml`.

# Set to 0 if you want multi-host ROS 2 discovery on a LAN; default 1 keeps traffic local.
# ROS_LOCALHOST_ONLY=1

# For native-Linux X11 passthrough: uncomment and pass `-v /tmp/.X11-unix:/tmp/.X11-unix`
# via a local override file. Most macOS/Windows users leave this unset — DISPLAY then
# defaults to the bundled noVNC service.
# DISPLAY=:0
