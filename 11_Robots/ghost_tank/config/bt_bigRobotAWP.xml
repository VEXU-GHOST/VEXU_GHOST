        backwards="false"
        distance_tiles="0.3"/>
      <ScorePosCmd active="true"/>
      <WaitCmd seconds="3.0"/>
      <ScorePosCmd active="false"/>  -->



     
    </Sequence>
  </BehaviorTree>
</root>
