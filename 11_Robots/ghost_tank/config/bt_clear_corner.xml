<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="clear_negative_corner">
    <Sequence>
      <Logging message="Go to corner stack"/>
      <ParallelAll>
        <NeutralStakeCmd state="0"
                        timeout="2.000"/>
        <Sequence>
          <LoadPathFromCSV
            file_path="test_path.txt"/>
          <FollowPathPurePursuit 
            xy_exit_threshold_tiles="0.05"
            angle_exit_threshold_deg="10.0"
            lin_vel_exit_threshold_tps="100.0"
            ang_vel_exit_threshold_dps="100.0"
            max_speed_linear_percent="1.0"
            max_speed_angular_percent="1.0"
            timeout_ms="2000"
            use_theta="false"
            min_pursuit_radius_tiles="0.7"
            k_lookahead="0.3"
            deceleration_start_distance_tiles="1.0"
            deceleration_exponent="1.5"
            min_approach_velocity_tps="0.05"/>

          <!-- <MoveToPoseJERRYIO file_path="test_path.txt"
                            search_radius_tiles="0.7"
                            xy_exit_threshold_tiles="0.10"
                            angle_exit_threshold_deg="10.0"
                            lin_vel_exit_threshold_tps="100.0"
                            ang_vel_exit_threshold_dps="100.0"
                            max_speed_linear_percent="0.5"
                            max_speed_angular_percent="1.0"
                            timeout_ms="1500"
                            use_theta="false"
                            backwards="false"/> -->
          <ShutoffNode/>
          <BiteCmd bite_closed="true"/>
          <ArcturnToPoint posX_tiles="0.1"
            posY_tiles="0.1"
            timeout_ms="2000"
            angle_exit_threshold_deg="1.0"
            ang_vel_exit_threshold_dps="10.0"
            drive_backwards="true"
            face_backwards="false"/>
          <!-- <GenerateBezierPath end_x_tiles="0.7"
            end_y_tiles="0.7"
            end_theta_deg="-135.0"
            lead_tiles="0.5"
            backwards="false"
            type="QUADRATIC_BEZIER"
            num_points="250"/>
          <FollowPathPurePursuit xy_exit_threshold_tiles="0.05"
            angle_exit_threshold_deg="3.0"
            lin_vel_exit_threshold_tps="1.0"
            ang_vel_exit_threshold_dps="10.0"
            max_speed_linear_percent="0.4"
            max_speed_angular_percent="1.0"
            timeout_ms="2000"
            use_theta="true"
            min_pursuit_radius_tiles="0.3"
            k_lookahead="0.3"
            deceleration_start_distance_tiles="0.5"
            deceleration_exponent="1.5"
            min_approach_velocity_tps="0.05"/> -->
        </Sequence>
      </ParallelAll>
      <Logging message="Processing Corner Stack"/>
      <IntakeCmd auto="true"
                 ground_intake="false"/>
      <Repeat num_cycles="3">
        <Sequence>
          <!-- <MoveVoltage forward_effort="0.3" angular_effort="0.0" timeout_ms="500"/> -->
          <MoveToPoint 
            kp="5.0"
            kd="0.0"
            max_effort_percent="0.5"
            timeout_ms="1000"
            xy_exit_threshold_tiles="1.0"/>
          <ShutoffNode/>
          <!-- <MoveVoltage forward_effort="-0.3" angular_effort="0.0" timeout_ms="500"/> -->
          <MoveToPoint 
            kp="5.0"
            kd="0.0"
            max_effort_percent="0.5"
            timeout_ms="1000"
            xy_exit_threshold_tiles="-0.5"/>
          <ShutoffNode/>
          <ArcturnToPoint posX_tiles="0.0"
                      posY_tiles="0.0"
                      timeout_ms="1000"
                      angle_exit_threshold_deg="1.0"
                      ang_vel_exit_threshold_dps="10.0"
                      drive_backwards="false"
                      face_backwards="false"/>
        </Sequence>
      </Repeat>
      <!-- <MoveVoltage forward_effort="-0.3" angular_effort="0.0" timeout_ms="400"/> -->
      <ShutoffNode/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="BiteCmd"
            editable="true">
      <input_port name="bite_closed"/>
    </Action>
    <Action ID="ClampCmd"
            editable="true">
      <input_port name="clamp_closed"/>
    </Action>
    <Action ID="ConveyorCmd"
            editable="true">
      <input_port name="fwd"/>
    </Action>
    <Action ID="GoalRushCmd"
            editable="true">
      <input_port name="goal_rush_down"/>
    </Action>
    <Action ID="SetMirrored"
            editable="true">
      <input_port name="mirrored"/>
    </Action>
    <Action ID="IntakeCmd"
            editable="true">
      <input_port name="active"/>
    </Action>
    <Action ID="Logging"
            editable="true">
      <input_port name="message"/>
    </Action>
    <Action ID="MoveToPosePurepursuit"
            editable="true">
      <input_port name="fileName"/>
      <input_port name="angle_threshold"
                  default="5.0">m</input_port>
      <input_port name="threshold"
                  default="0.025">m</input_port>
      <input_port name="timeout"
                  default="5000">ms</input_port>
      <input_port name="use_theta"
                  default="false"/>
    </Action>
    <Action ID="ShutoffNode"
            editable="true"/>
  </TreeNodesModel>

</root>