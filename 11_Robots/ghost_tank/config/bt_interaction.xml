<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="test_cv_target">
  
  <BehaviorTree ID="test_cv_target">
    <Sequence>
      <Logging message="Starting CV target test" />
      <MoveToCVTarget 
        distance_threshold_m="0.3"
        angle_threshold_deg="10.0"
        max_linear_speed="0.5"
        timeout_ms="10000"
        target_object_id="-1"/>
      <Logging message="CV target reached" />
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="main">
    <Sequence>
      <!-- <KeepRunningUntilFailure> -->
        <!-- <AutonTimer seconds="2"> -->
          <Sequence>
            <IntakeCmd auto="false"
              ground_intake="false"
              store_ring="false"/>
            <SetMirrored mirrored="true"/>
            <BiteCmd bite_closed="true"/>
            <!-- <ClampCmd clamp_closed="true"/> -->
            <!-- <GenerateBezierPath end_x_tiles="1.0"
              end_y_tiles="1.0"
              end_theta_deg="45.0"
              lead_tiles="1.0"
              backwards="true"
              type="QUADRATIC_BEZIER"
              num_points="250"/>
            <FollowPathPurePursuit xy_exit_threshold_tiles="0.25"
              angle_exit_threshold_deg="3.0"
              lin_vel_exit_threshold_tps="1.0"
              ang_vel_exit_threshold_dps="10.0"
              xy_settling_radius_tiles="0.0"
              max_speed_linear_percent="1.0"
              max_speed_angular_percent="1.0"
              timeout_ms="3500"
              use_theta="true"
              min_pursuit_radius_tiles="0.3"
              k_lookahead="0.3"
              deceleration_start_distance_tiles="1.0"
              deceleration_exponent="1.5"
              min_approach_velocity_tps="0.05"/> -->
            <!-- <Repeat num_cycles="-1">
              <Logging message="interacting"/>
            </Repeat> -->
          </Sequence>
        <!-- </AutonTimer> -->
      <!-- </KeepRunningUntilFailure> -->
      <Sequence>
        <ClampCmd clamp_closed="true"/>
        <Logging message="leave corner"/>
        <GenerateBezierPath end_x_tiles="1.0"
          end_y_tiles="1.8"
          end_theta_deg="90.0"
          lead_tiles="1.0"
          backwards="false"
          type="QUADRATIC_BEZIER"
          num_points="250"/>
        <FollowPathPurePursuit xy_exit_threshold_tiles="0.25"
          angle_exit_threshold_deg="3.0"
          lin_vel_exit_threshold_tps="1.0"
          ang_vel_exit_threshold_dps="10.0"
          xy_settling_radius_tiles="0.0"
          max_speed_linear_percent="0.4"
          max_speed_angular_percent="1.0"
          timeout_ms="3500"
          use_theta="true"
          min_pursuit_radius_tiles="0.3"
          k_lookahead="0.3"
          deceleration_start_distance_tiles="1.0"
          deceleration_exponent="1.5"
          min_approach_velocity_tps="0.05"/>

        <Logging message="facing ladder"/>

        <TurnToPoint posX_tiles="2.0"
          posY_tiles="3.0"
          timeout_ms="2000"
          backwards="false"
          angle_exit_threshold_deg="1.0"/>
        <BiteCmd bite_closed="false"/>
        <MoveToPoint kp="5.0"
          kd="0.0"
          max_effort_percent="0.2"
          timeout_ms="3000"
          backwards="false"
          distance_tiles="0.4"/>
        <MoveToPoint kp="5.0"
          kd="0.0"
          max_effort_percent="0.2"
          timeout_ms="3000"
          backwards="true"
          distance_tiles="0.4"/>

        <Logging message="turning around"/>

        <TurnToPoint posX_tiles="2.0"
          posY_tiles="3.0"
          timeout_ms="2000"
          backwards="true"
          angle_exit_threshold_deg="1.0"/>
        <IntakeCmd auto="false"
          ground_intake="false"
          store_ring="false"/>

        <Logging message="shoving ring under"/>
        
        <Repeat num_cycles="2">
          <Sequence>
            <MoveToPoint kp="5.0"
              kd="0.0"
              max_effort_percent="0.4"
              timeout_ms="2000"
              backwards="true"
              distance_tiles="0.6"/>
            <MoveToPoint kp="5.0"
              kd="0.0"
              max_effort_percent="0.2"
              timeout_ms="2000"
              backwards="false"
              distance_tiles="0.4"/>
          </Sequence>
        </Repeat>
        
        <!-- <MoveToPoint kp="5.0"
        kd="0.0"
        max_effort_percent="0.2"
        timeout_ms="2000"
        backwards="false"
        distance_tiles="0.5"/>

        <TurnToPoint posX_tiles="2.0"
          posY_tiles="3.0"
          timeout_ms="2000"
          backwards="false"
          angle_exit_threshold_deg="1.0"/>


        <GenerateBezierPath end_x_tiles="1.25"
          end_y_tiles="2.25"
          end_theta_deg="45.0"
          lead_tiles="1.0"
          backwards="false"
          type="CUBIC_BEZIER"
          num_points="250"/>
        <FollowPathPurePursuit xy_exit_threshold_tiles="0.05"
          angle_exit_threshold_deg="3.0"
          lin_vel_exit_threshold_tps="1.0"
          ang_vel_exit_threshold_dps="10.0"
          xy_settling_radius_tiles="0.0"
          max_speed_linear_percent="0.3"
          max_speed_angular_percent="1.0"
          timeout_ms="3500"
          use_theta="true"
          min_pursuit_radius_tiles="0.3"
          k_lookahead="0.3"
          deceleration_start_distance_tiles="1.0"
          deceleration_exponent="1.5"
          min_approach_velocity_tps="0.05"/> -->

        <Logging message="facing ladder to climb"/>
        <TurnToPoint posX_tiles="2.0"
          posY_tiles="3.0"
          timeout_ms="2000"
          backwards="false"
          angle_exit_threshold_deg="1.0"/>
        <BiteCmd bite_closed="false"/>
        <MoveToPoint kp="5.0"
          kd="0.0"
          max_effort_percent="0.2"
          timeout_ms="2000"
          backwards="false"
          distance_tiles="0.6"/>

        <Logging message="waiting until end of match"/>
        
        <Fallback>
          <KeepRunningUntilFailure>
            <AutonTimer seconds="87">
              <WaitCmd seconds="500.0"
                shutoff_motors="true"/>
            </AutonTimer>
          </KeepRunningUntilFailure>
          <Sequence>
            <MoveToPoint kp="4.0"
              kd="0.0"
              max_effort_percent="0.8"
              timeout_ms="3000"
              backwards="true"
              distance_tiles="0.5"/>
          </Sequence>
        </Fallback>
        <WaitCmd seconds="500.0"
          shutoff_motors="true"/>
      </Sequence>
    </Sequence>
  </BehaviorTree>

</root>
