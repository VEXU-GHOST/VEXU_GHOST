{
  "name": "VEXU Ghost (ROS 2 Humble)",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "vexu",
  "workspaceFolder": "/vexu",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true
      },
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "twxs.cmake",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-iot.vscode-ros",
        "redhat.vscode-yaml",
        "smilerobotics.urdf",
        "zachflower.uncrustify",
        "ms-vsliveshare.vsliveshare"
      ]
    }
  }
}
