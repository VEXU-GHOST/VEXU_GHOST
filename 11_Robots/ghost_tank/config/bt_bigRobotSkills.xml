<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
  main_tree_to_execute="bt_clyde_tuning"

>
  <!-- <include path="bt_scoring.xml"/> -->
  <include path="bt_score_lift_release.xml"/>
  <BehaviorTree ID="bt_clyde_tuning"
  >
    <Sequence>
    <ClampCmd clamp_closed="true"/>
    <LiftPosCmd stage="2"/> 
      <!-- move back to goal -->
    <MoveToPoint posX_tiles="1.3"
        posY_tiles="4.5"
        backwards="true"
        turn_timeout_ms="0"
        move_timeout_ms="700"
        angle_exit_threshold_deg="3.0"
        angle_settle_ms="0"
        ang_vel_exit_threshold_dps="20.0"
        max_effort_percent="0.8"
        heading_hold_cutoff_m="0.01"
        heading_kp="-0.1"
        heading_kd="0.0"
        settle_dist_tiles="0.05"
        settle_speed_tiles_per_s="0.08"
        chain="true"
        chain_min_effort_percent="0.3"/>

    <MoveToPoint posX_tiles="2.0"
        posY_tiles="5.0"
        backwards="true"
        turn_timeout_ms="500"
        move_timeout_ms="1000"
        angle_exit_threshold_deg="3.0"
        angle_settle_ms="200"
        ang_vel_exit_threshold_dps="20.0"
        max_effort_percent="0.8"
        heading_hold_cutoff_m="0.2"
        heading_kp="-0.1"
        heading_kd="0.0"
        settle_dist_tiles="0.05"
        settle_speed_tiles_per_s="0.08"
        chain="false"
        chain_min_effort_percent="0.2"/>
    <!-- Score -->
    <LiftPosCmd stage="0"/> 
    <ArmPosCmd stage="0"/> 
    <WaitCmd seconds="0.3"/>
    <ClampCmd clamp_closed="false"/>
    <MoveToPoint posX_tiles="1.3"
        posY_tiles="4.5"
        backwards="false"
        turn_timeout_ms="0"
        move_timeout_ms="700"
        angle_exit_threshold_deg="3.0"
        angle_settle_ms="0"
        ang_vel_exit_threshold_dps="20.0"
        max_effort_percent="0.8"
        heading_hold_cutoff_m="0.01"
        heading_kp="-0.1"
        heading_kd="0.0"
        settle_dist_tiles="0.05"
        settle_speed_tiles_per_s="0.08"
        chain="true"
        chain_min_effort_percent="0.3"/>
    
    <MoveToPoint posX_tiles="1.0"
        posY_tiles="5.0"
        backwards="true"
        turn_timeout_ms="700"
        move_timeout_ms="1000"
        angle_exit_threshold_deg="3.0"
        angle_settle_ms="200"
        ang_vel_exit_threshold_dps="20.0"
        max_effort_percent="0.8"
        heading_hold_cutoff_m="0.2"
        heading_kp="-0.1"
        heading_kd="0.0"
        settle_dist_tiles="0.05"
        settle_speed_tiles_per_s="0.08"
        chain="false"
        chain_min_effort_percent="0.2"/>
    <!-- Set arm and lift into scoring position -->
    <LiftPosCmd stage="3"/> 
    <ArmPosCmd stage="2"/> 
    <ClampCmd clamp_closed="true"/>
    <MoveToPoint posX_tiles="2.0"
        posY_tiles="5.0"
        backwards="true"
        turn_timeout_ms="500"
        move_timeout_ms="1000"
        angle_exit_threshold_deg="3.0"
        angle_settle_ms="200"
        ang_vel_exit_threshold_dps="20.0"
        max_effort_percent="0.8"
        heading_hold_cutoff_m="0.2"
        heading_kp="-0.1"
        heading_kd="0.0"
        settle_dist_tiles="0.05"
        settle_speed_tiles_per_s="0.08"
        chain="false"
        chain_min_effort_percent="0.2"/>



    <!-- Get second pin -->
    <MoveToPoint posX_tiles="1.3"
        posY_tiles="4.5"
        backwards="false"
        turn_timeout_ms="0"
        move_timeout_ms="700"
        angle_exit_threshold_deg="3.0"
        angle_settle_ms="0"
        ang_vel_exit_threshold_dps="20.0"
        max_effort_percent="0.8"
        heading_hold_cutoff_m="0.01"
        heading_kp="-0.1"
        heading_kd="0.0"
        settle_dist_tiles="0.05"
        settle_speed_tiles_per_s="0.08"
        chain="true"
        chain_min_effort_percent="0.3"/>
    
    <MoveToPoint posX_tiles="2.0"
        posY_tiles="4.0"
        backwards="true"
        turn_timeout_ms="700"
        move_timeout_ms="1000"
        angle_exit_threshold_deg="3.0"
        angle_settle_ms="200"
        ang_vel_exit_threshold_dps="20.0"
        max_effort_percent="0.8"
        heading_hold_cutoff_m="0.2"
        heading_kp="-0.1"
        heading_kd="0.0"
        settle_dist_tiles="0.05"
        settle_speed_tiles_per_s="0.08"
        chain="false"
        chain_min_effort_percent="0.2"/>
    <!-- Set arm and lift into scoring position -->
    <LiftPosCmd stage="4"/> 
    <ArmPosCmd stage="2"/> 
    <ClampCmd clamp_closed="true"/>
    <MoveToPoint posX_tiles="2.0"
        posY_tiles="5.0"
        backwards="true"
        turn_timeout_ms="500"
        move_timeout_ms="1000"
        angle_exit_threshold_deg="3.0"
        angle_settle_ms="200"
        ang_vel_exit_threshold_dps="20.0"
        max_effort_percent="0.8"
        heading_hold_cutoff_m="0.2"
        heading_kp="-0.1"
        heading_kd="0.0"
        settle_dist_tiles="0.05"
        settle_speed_tiles_per_s="0.08"
        chain="false"
        chain_min_effort_percent="0.2"/> 
      <WaitCmd seconds="300000.0"/>
      <!-- <TurnToPoint posX_tiles="0.0"
        posY_tiles="1.0"
        timeout_ms="3000"
        backwards="false"
        angle_exit_threshold_deg=".5"/> -->
      <!-- <MoveForward kp="1.6"
        kd="0.0"
        max_effort_percent="0.35"
        timeout_ms="3000"
        backwards="false"
        distance_tiles="0.3"/>
      <ScorePosCmd active="true"/>
      <WaitCmd seconds="3.0"/>
      <ScorePosCmd active="false"/>  -->



     
    </Sequence>
  </BehaviorTree>
</root>
