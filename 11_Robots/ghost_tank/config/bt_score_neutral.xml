<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="score_neutral">
    <Sequence>
      <Logging message="score neutral stake"/>
      <MoveToPoseBezier posX_tiles="2.9"
                        posY_tiles="1.0"
                        theta_deg="-90.0"
                        search_radius_tiles="0.3"
                        xy_exit_threshold_tiles="0.1"
                        angle_exit_threshold_deg="5.0"
                        lin_vel_exit_threshold_tps="0.1"
                        ang_vel_exit_threshold_dps="1.0"
                        lead="0.2"
                        max_speed_linear_percent="1.0"
                        max_speed_angular_percent="1.0"
                        timeout_ms="-5000"
                        use_theta="true"
                        backwards="false"/>
      <MoveToPoseBezier posX_tiles="2.9"
                        posY_tiles="0.75"
                        theta_deg="-90.0"
                        search_radius_tiles="0.3"
                        xy_exit_threshold_tiles="0.03"
                        angle_exit_threshold_deg="1.0"
                        lin_vel_exit_threshold_tps="0.1"
                        ang_vel_exit_threshold_dps="1.0"
                        lead="0.4"
                        max_speed_linear_percent="1.0"
                        max_speed_angular_percent="1.0"
                        timeout_ms="-5000"
                        use_theta="true"
                        backwards="false"/>
      <ShutoffNode/>
      <Logging message="load ring"/>
      <NeutralStakeCmd state="1"
                       timeout="0.500"/>
      <ConveyorCmd fwd="true"/>
      <WaitCmd seconds="0.500"
                shutoff_motors="true"/>
      <ConveyorCmd fwd="false"/>
      <NeutralStakeCmd state="2"
                       timeout="1.00"/>
      <NeutralStakeCmd state="3"
                       timeout="0.500"/>
      <ParallelAll>
        <NeutralStakeCmd state="4"
                        timeout="1.200"/>
        <Delay delay_msec="200">
        <MoveToPoseBezier posX_tiles="3.0"
                          posY_tiles="1.4"
                          theta_deg="-90.0"
                          search_radius_tiles="0.3"
                          xy_exit_threshold_tiles="0.1"
                          angle_exit_threshold_deg="5.0"
                          lin_vel_exit_threshold_tps="0.1"
                          ang_vel_exit_threshold_dps="1.0"
                          lead="0.4"
                          max_speed_linear_percent="0.2"
                          max_speed_angular_percent="1.0"
                          timeout_ms="-5000"
                          use_theta="true"
                          backwards="true"/>
        </Delay>
      </ParallelAll>
      <NeutralStakeCmd state="0"
                       timeout="0.500"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="BiteCmd"
            editable="true">
      <input_port name="bite_closed"/>
    </Action>
    <Action ID="ClampCmd"
            editable="true">
      <input_port name="clamp_closed"/>
    </Action>
    <Action ID="ConveyorCmd"
            editable="true">
      <input_port name="fwd"/>
    </Action>
    <Action ID="GoalRushCmd"
            editable="true">
      <input_port name="arm_down"/>
    </Action>
    <Action ID="SetMirrored"
            editable="true">
      <input_port name="mirrored"/>
    </Action>
    <Action ID="IntakeCmd"
            editable="true">
      <input_port name="active"/>
    </Action>
    <Action ID="Logging"
            editable="true">
      <input_port name="message"/>
    </Action>
    <Action ID="MoveToPoseBezier"
            editable="true">
      <input_port name="posX_tiles"/>
      <input_port name="posY_tiles"/>
      <input_port name="theta_deg"/>
      <input_port name="search_radius_tiles"/>
      <input_port name="xy_exit_threshold_tiles"/>
      <input_port name="angle_exit_threshold_deg"/>
      <input_port name="lin_vel_exit_threshold_tps"/>
      <input_port name="ang_vel_exit_threshold_dps"/>
      <input_port name="lead"/>
      <input_port name="max_speed_linear_percent"/>
      <input_port name="max_speed_angular_percent"/>
      <input_port name="timeout_ms"/>
      <input_port name="use_theta"/>
      <input_port name="backwards"/>
    </Action>
    <Action ID="MoveToPosePurepursuit"
            editable="true">
      <input_port name="fileName"/>
      <input_port name="angle_threshold"
                  default="5.0">m</input_port>
      <input_port name="threshold"
                  default="0.025">m</input_port>
      <input_port name="timeout"
                  default="5000">ms</input_port>
      <input_port name="use_theta"
                  default="false"/>
    </Action>
    <Action ID="ShutoffNode"
            editable="true"/>
    <Action ID="NeutralStakeCmd"
            editable="true">
      <input_port name="state"/>
      <input_port name="timeout"/>
    </Action>
  </TreeNodesModel>

</root>