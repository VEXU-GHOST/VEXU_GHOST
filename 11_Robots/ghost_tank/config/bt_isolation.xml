      <MoveToPoseBoomerang
        posX_tiles="2.5"
        posY_tiles="1.5"
        theta_deg="45.0"
        search_radius_m="0.3"
        threshold_m="0.2"
        angle_threshold_deg="3.0"
        threshold_vel_mps="0.1"
        angle_threshold_vel_dps="1.0"
