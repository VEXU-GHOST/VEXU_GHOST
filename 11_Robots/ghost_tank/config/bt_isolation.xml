          <Logging message="Go to corner stack"/>
          <MoveToPoseBoomerang posX_tiles="0.75"
                                posY_tiles="0.75"
                                theta_deg="225.0"
                                search_radius_m="0.3"
                                threshold_m="0.05"
                                angle_threshold_deg="3.0"
