<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="center_goal">
    <Sequence>
      <Logging message="Going to goal"/>
      <BiteCmd bite_closed="false"/>
      <ClampCmd clamp_closed="false"/>

      <MoveToPoseBezier posX_tiles="2.2"
                            posY_tiles="1.0"
                            theta_deg="180.0"
                            search_radius_m="0.3"
                            threshold_m="0.10"
                            angle_threshold_deg="3.0"
                            threshold_vel_mps="0.1"
                            angle_threshold_vel_dps="1.0"
                            lead="1.0"
                            max_speed_linear_pct="1.0"
                            max_speed_angular_pct="1.0"
                            timeout_ms="-2000"
                            use_theta="true"
                            backwards="true"/>
      <!-- Move closer to goal again slower for precision -->
        <!-- <MoveToPoseBezier posX_tiles="3.3"
                        posY_tiles="1.1"
