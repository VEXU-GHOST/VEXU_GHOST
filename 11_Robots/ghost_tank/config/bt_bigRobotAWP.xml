<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
  main_tree_to_execute="bt_clyde_tuning"

>
  <!-- <include path="bt_scoring.xml"/> -->
  <include path="bt_score_lift_release.xml"/>
  <BehaviorTree ID="bt_clyde_tuning"
  >
    <Sequence>
    <ClampCmd clamp_closed="true"/>
    <ToggleMechCmd rotations="5.0"/>
    <LiftPosCmd stage="2"/>
    <MoveToPoint kp="1.6"
        kd="0.5"
        max_effort_percent="0.35"
        timeout_ms="1000"
        backwards="true"
        distance_tiles="0.75"/>
    <!-- <AutoClawCmd/> -->
    <ArmPosCmd stage="2"/>
    <ActuallyMoveToPoint posX_tiles="4.15"
        posY_tiles="5.0"
        backwards="true"
        turn_timeout_ms="700"
        move_timeout_ms="700"
        angle_exit_threshold_deg="3.0"
        angle_settle_ms="300"
        kp="1.6"
        kd="0.5"
        max_effort_percent="0.3"/>
    <LiftPosCmd stage="0"/>
    <WaitCmd seconds="0.5"/>
    <ClampCmd clamp_closed="false"/>
    <ActuallyMoveToPoint posX_tiles="3.6"
        posY_tiles="4.6"
        backwards="false"
        turn_timeout_ms="500"
        move_timeout_ms="500"
        angle_exit_threshold_deg="3.0"
        angle_settle_ms="300"
        kp="1.6"
        kd="0.5"
        max_effort_percent="0.5"/>
    <!-- Async: lift down, clamp open, arm extended, and the tree moves on right
         away. The ClampCmd below closes the clamp, which reverts the arm and
         raises the lift. (timeout_s="N" would close it N s from here instead.) -->
      <MatchloadCmd active="true"
        auto_close="true"/>
      <ActuallyMoveToPoint posX_tiles="4.12"
        posY_tiles="5.6"
        backwards="true"
        turn_timeout_ms="800"
        move_timeout_ms="700"
        angle_exit_threshold_deg="3.0"
        angle_settle_ms="300"
        kp="1.6"
        kd="0.5"
        max_effort_percent="0.30"/>
    <SwingToAngle angle_deg="295"
      timeout_ms="400"
      locked_side="right"
      angle_exit_threshold_deg="3.0"
      angle_settle_ms="300"
      max_effort_percent="0.8"/>
  <MatchloadCmd active="false"
      auto_close="true"/>
     <WaitCmd seconds="0.2"/>
    <ClampCmd clamp_closed="true"/>
     <WaitCmd seconds="0.2"/>
    <LiftPosCmd stage="3"/>
    <ArmPosCmd stage="2"/>
    <ActuallyMoveToPoint posX_tiles="4.0"
        posY_tiles="5.0"
        backwards="true"
        turn_timeout_ms="1000"
        move_timeout_ms="700"
        angle_exit_threshold_deg="3.0"
        angle_settle_ms="300"
        kp="1.6"
        kd="0.5"
        max_effort_percent="0.3"/>
    <LiftPosCmd stage="0"/>
    <WaitCmd seconds="0.25"/>
    <ClampCmd clamp_closed="false"/>
    <MoveToPoint kp="1.6"
        kd="0.0"
        max_effort_percent="0.35"
        timeout_ms="300"
        backwards="false"
        distance_tiles="0.5"/>
     <ActuallyMoveToPoint posX_tiles="3.5"
        posY_tiles="5.5"
        backwards="true"
        turn_timeout_ms="700"
        move_timeout_ms="1000"
        angle_exit_threshold_deg="3.0"
        angle_settle_ms="300"
        kp="1.6"
        kd="0.5"
        max_effort_percent="0.3"/>
    <MatchloadCmd active="true"
        auto_close="true"/>
    <ActuallyMoveToPoint posX_tiles="2.0"
        posY_tiles="4.0"
        backwards="true"
        turn_timeout_ms="700"
        move_timeout_ms="1200"
        angle_exit_threshold_deg="3.0"
        angle_settle_ms="300"
        kp="1.6"
        kd="0.5"
        max_effort_percent="0.8"/>
    <MatchloadCmd active="false"
        auto_close="true"/>
    <ClampCmd clamp_closed="true"/>
    <LiftPosCmd stage="3"/>
    <ArmPosCmd stage="2"/>
    <ActuallyMoveToPoint posX_tiles="0.5"
        posY_tiles="2.0"
        backwards="true"
        turn_timeout_ms="700"
        move_timeout_ms="1800"
        angle_exit_threshold_deg="3.0"
        angle_settle_ms="300"
        kp="1.6"
        kd="0.5"
        max_effort_percent="0.8"/>
      <LiftPosCmd stage="0"/>
      
      
    <!-- <AutoClawCmd close_mm="75" 
        timeout_s="3" 
        sensor_name="auto_claw"/> -->

