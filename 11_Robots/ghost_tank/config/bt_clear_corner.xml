<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="clear_corner">
    <Sequence>
      <Logging message="clear corner left"/>
      <Logging message="Go to corner stack"/>
      <BiteCmd bite_closed="true"/>
      <MoveToPoseBezier posX_tiles="0.75"
                            posY_tiles="0.75"
                            theta_deg="225.0"
                            search_radius_tiles="0.5"
                            xy_exit_threshold_tiles="0.05"
                            angle_exit_threshold_deg="3.0"
                            lin_vel_exit_threshold_tps="0.1"
                            ang_vel_exit_threshold_dps="1.0"
                            lead="0.5"
                            max_speed_linear_percent="0.4"
                            max_speed_angular_percent="1.0"
                            timeout_ms="-5000"
                            use_theta="true"
                            backwards="false"/>

      <!-- <WaitCmd seconds="100.00" -->
                <!-- shutoff_motors="true"/> -->
      <Logging message="Processing Corner Stack"/>
      <IntakeCmd auto="true"
                 ground_intake="false"/>
      <Repeat num_cycles="2">
        <Sequence>
          <MoveVoltage forward_effort="0.3" angular_effort="0.0" timeout_ms="1000"/>
          <ShutoffNode/>
          <MoveVoltage forward_effort="-0.3" angular_effort="0.0" timeout_ms="1000"/>
          <ShutoffNode/>
        </Sequence>
      </Repeat>

      <MoveToPoseBezier
        posX_tiles="1.0"
        posY_tiles="1.0"
        theta_deg="45.0"
        search_radius_tiles="0.5"
        xy_exit_threshold_tiles="0.05"
        angle_exit_threshold_deg="3.0"
        lin_vel_exit_threshold_tps="0.1"
        ang_vel_exit_threshold_dps="1.0"
        lead="0.5"
        max_speed_linear_percent="1.0"
        max_speed_angular_percent="1.0"
        timeout_ms="-2000"
        use_theta="true"
        backwards="true"/>
      <ShutoffNode/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="BiteCmd"
            editable="true">
      <input_port name="bite_closed"/>
    </Action>
    <Action ID="ClampCmd"
            editable="true">
      <input_port name="clamp_closed"/>
    </Action>
    <Action ID="ConveyorCmd"
            editable="true">
      <input_port name="fwd"/>
    </Action>
    <Action ID="GoalRushCmd"
            editable="true">
      <input_port name="arm_down"/>
    </Action>
    <Action ID="SetMirrored"
            editable="true">
      <input_port name="mirrored"/>
    </Action>
    <Action ID="IntakeCmd"
            editable="true">
      <input_port name="active"/>
    </Action>
    <Action ID="Logging"
            editable="true">
      <input_port name="message"/>
    </Action>
    <Action ID="MoveToPoseBezier"
            editable="true">
      <input_port name="posX_tiles"/>
      <input_port name="posY_tiles"/>
      <input_port name="theta_deg"/>
      <input_port name="search_radius_tiles"/>
      <input_port name="xy_exit_threshold_tiles"/>
      <input_port name="angle_exit_threshold_deg"/>
      <input_port name="lin_vel_exit_threshold_tps"/>
      <input_port name="ang_vel_exit_threshold_dps"/>
      <input_port name="lead"/>
      <input_port name="max_speed_linear_percent"/>
      <input_port name="max_speed_angular_percent"/>
      <input_port name="timeout_ms"/>
      <input_port name="use_theta"/>
      <input_port name="backwards"/>
    </Action>
    <Action ID="MoveToPosePurepursuit"
            editable="true">
      <input_port name="fileName"/>
      <input_port name="angle_threshold"
                  default="5.0">m</input_port>
      <input_port name="threshold"
                  default="0.025">m</input_port>
      <input_port name="timeout"
                  default="5000">ms</input_port>
      <input_port name="use_theta"
                  default="false"/>
    </Action>
    <Action ID="ShutoffNode"
            editable="true"/>
  </TreeNodesModel>

</root>