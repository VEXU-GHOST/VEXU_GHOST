<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="baby_jerry_sim">

  <!-- 1. Include Baby Jerry's Base URDF -->
  <xacro:include filename="$(find ghost_visualization_assets)/baby_jerry/urdf/baby_jerry.urdf" />

  <!-- 2. Define RealSense Link -->
  <link name="realsense_link">
    <visual>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
      <material name="silver">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.072"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- 3. Attach RealSense Joint to base_link -->
  <joint name="realsense_joint" type="fixed">
    <parent link="base_link"/>
    <child link="realsense_link"/>
    <!-- Tune these x, y, z and rpy offsets to match where the RealSense sits on the physical chassis -->
    <origin xyz="0.12 0 0.25" rpy="0 0 0"/>
  </joint>

  <!-- 4. Gazebo Depth Camera Plugin for RealSense -->
  <gazebo reference="realsense_link">
    <sensor type="depth" name="realsense_depth_sensor">
      <update_rate>30.0</update_rate>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov> <!-- ~87 deg FOV for D435 -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin name="realsense_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/realsense</namespace>
          <remapping>image_raw:=color/image_raw</remapping>
          <remapping>depth/image_raw:=depth/image_raw</remapping>
          <remapping>camera_info:=color/camera_info</remapping>
          <remapping>depth/camera_info:=depth/camera_info</remapping>
          <remapping>points:=depth/color/points</remapping>
        </ros>
        <camera_name>realsense</camera_name>
        <frame_name>realsense_link</frame_name>
        <min_depth>0.1</min_depth>
        <max_depth>10.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

</robot>
