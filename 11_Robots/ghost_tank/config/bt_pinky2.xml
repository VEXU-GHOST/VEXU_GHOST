        shutoff_motors="true"/>
      <SwitcherCmd switcher_active="false"/>
      <WaitCmd seconds="2.0"
        shutoff_motors="true"/> -->

      <!-- ===== Little Will (digital port 7) ===== -->
      <!-- <LittleWillCmd little_will_active="true"/>
