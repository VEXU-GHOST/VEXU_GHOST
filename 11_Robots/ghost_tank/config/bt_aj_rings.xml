<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <include path="bt_center_goal.xml"/>
  <BehaviorTree ID="aj_rings">
    <Sequence>
      <Logging message="grab the goal"/>
      <GoalRushCmd goal_rush_down="false"/>
      <MoveToPoseBezier posX_tiles="1.7"
                            posY_tiles="1.25"
                            theta_deg="-45.0"
                            search_radius_tiles="0.1"
                            xy_exit_threshold_tiles="0.05"
                            angle_exit_threshold_deg="3.0"
                            lin_vel_exit_threshold_tps="0.1"
                            ang_vel_exit_threshold_dps="1.0"
                            lead="0.75"
                            max_speed_linear_percent="0.5"
                            max_speed_angular_percent="1.0"
                            timeout_ms="-2000"
                            use_theta="true"
                            backwards="true"/>
      <!-- <MoveToPoseBezier posX_tiles="1.5"
                            posY_tiles="2.0"
                            theta_deg="-45.0"
                            search_radius_tiles="0.3"
                            xy_exit_threshold_tiles="0.05"
                            angle_exit_threshold_deg="3.0"
                            lin_vel_exit_threshold_tps="0.1"
                            ang_vel_exit_threshold_dps="1.0"
                            lead="0.75"
                            max_speed_linear_percent="1.0"
                            max_speed_angular_percent="1.0"
                            timeout_ms="-2000"
                            use_theta="true"
                            backwards="true"/> -->
      <Logging message="Back Up Further and Clamp Goal"/>
      <ParallelAll>
        <Fallback>
          <Timeout msec="1000">
            <KeepRunningUntilFailure>
              <ClampCmd clamp_closed="false"/>
            </KeepRunningUntilFailure>
          </Timeout>
          <ClampCmd clamp_closed="true"/>
        </Fallback>
        <MoveToPoseBezier posX_tiles="1.0"
                            posY_tiles="2.5"
                            theta_deg="-90.0"
                            search_radius_tiles="0.3"
                            xy_exit_threshold_tiles="0.05"
                            angle_exit_threshold_deg="3.0"
                            lin_vel_exit_threshold_tps="0.1"
                            ang_vel_exit_threshold_dps="1.0"
                            lead="1.0"
                            max_speed_linear_percent="0.4"
                            max_speed_angular_percent="1.0"
                            timeout_ms="-2000"
                            use_theta="true"
                            backwards="true"/>
      </ParallelAll>
      <ClampCmd clamp_closed="true"/>

      <!-- <WaitCmd seconds="100.00" -->
                <!-- shutoff_motors="true"/> -->
   
      <Logging message="Processing stack2"/>
      <!-- <IntakeCmd auto="true"
                 ground_intake="false"/> -->
      <MoveToPoseBezier posX_tiles="1.0"
                              posY_tiles="1.0"
                              theta_deg="-135.0"
                              search_radius_tiles="0.3"
                              xy_exit_threshold_tiles="0.02"
                              angle_exit_threshold_deg="1.0"
                              lin_vel_exit_threshold_tps="0.1"
                              ang_vel_exit_threshold_dps="1.0"
                              lead="0.5"
                              max_speed_linear_percent="0.8"
                              max_speed_angular_percent="1.0"
                              timeout_ms="-2000"
                              use_theta="true"
                              backwards="false"/>
      <ShutoffNode/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="BiteCmd"
            editable="true">
      <input_port name="bite_closed"/>
    </Action>
    <Action ID="ClampCmd"
            editable="true">
      <input_port name="clamp_closed"/>
    </Action>
    <Action ID="ConveyorCmd"
            editable="true">
      <input_port name="fwd"/>
    </Action>
    <Action ID="GoalRushCmd"
            editable="true">
      <input_port name="goal_rush_down"/>
    </Action>
    <Action ID="SetMirrored"
            editable="true">
      <input_port name="mirrored"/>
    </Action>
    <Action ID="IntakeCmd"
            editable="true">
      <input_port name="active"/>
    </Action>
    <Action ID="Logging"
            editable="true">
      <input_port name="message"/>
    </Action>
    <Action ID="MoveToPoseBezier"
            editable="true">
      <input_port name="posX_tiles"/>
      <input_port name="posY_tiles"/>
      <input_port name="theta_deg"/>
      <input_port name="search_radius_tiles"/>
      <input_port name="xy_exit_threshold_tiles"/>
      <input_port name="angle_exit_threshold_deg"/>
      <input_port name="lin_vel_exit_threshold_tps"/>
      <input_port name="ang_vel_exit_threshold_dps"/>
      <input_port name="lead"/>
      <input_port name="max_speed_linear_percent"/>
      <input_port name="max_speed_angular_percent"/>
      <input_port name="timeout_ms"/>
      <input_port name="use_theta"/>
      <input_port name="backwards"/>
    </Action>
    <Action ID="MoveToPosePurepursuit"
            editable="true">
      <input_port name="fileName"/>
      <input_port name="angle_threshold"
                  default="5.0">m</input_port>
      <input_port name="threshold"
                  default="0.025">m</input_port>
      <input_port name="timeout"
                  default="5000">ms</input_port>
      <input_port name="use_theta"
                  default="false"/>
    </Action>
    <Action ID="ShutoffNode"
            editable="true"/>
  </TreeNodesModel>

</root>